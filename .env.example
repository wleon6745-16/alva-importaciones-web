# Copia este archivo a .env (local) o configura la variable en el entorno del hosting
# (nunca en el repo). Ver docs/ANALYTICS.md.

# Measurement ID de Google Analytics 4. Sin esta variable, el sitio funciona igual — Analytics.astro
# simplemente no carga gtag.js y trackEvent() sigue empujando a window.dataLayer sin efecto real.
# Formato real: "G-" seguido de 10 caracteres alfanuméricos. El valor de abajo NO es un ID
# funcional, es un placeholder de ejemplo.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Storefront API de ASISTENTE (catalogo real, ver docs/ALVA_2.0_PROPOSAL.md y
# el reporte de Fase 2 de este mismo repo). Sin estas dos variables, el build
# se apoya en el ultimo snapshot commiteado en src/content/storefront/ y
# CatalogExplorer no se renderiza -- el sitio sigue funcionando igual.
# channelId NO es secreto (identifica el tenant, no autentica -- ver
# ASISTENTE/docs/web-channel-phase513.md seccion D), es seguro exponerlo en
# el bundle del navegador.
PUBLIC_STOREFRONT_API_URL=http://localhost:4000
PUBLIC_STOREFRONT_CHANNEL_ID=dce669d5-0286-4453-bfbd-50435cca053f
