# PLANTILLA — no instalada. Ver docs/AUTOMATED_TASKS.md antes de usar en un servidor real.
# Ajustar WorkingDirectory, User, EnvironmentFile y ExecStart a la ruta/usuario reales.

[Unit]
Description=Alva Importaciones - sincronizacion del catalogo publico
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/alva-importaciones-web
EnvironmentFile=-/opt/alva-importaciones-web/.env
ExecStart=/usr/bin/npm run catalog:sync
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alva-catalog-sync

[Install]
WantedBy=multi-user.target
