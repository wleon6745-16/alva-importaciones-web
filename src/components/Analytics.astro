---
// Carga condicional de Google Analytics 4 / Meta Pixel + tracking de clics/impresiones.
// Sin PUBLIC_GA_MEASUREMENT_ID configurada, no se renderiza ningún script de gtag.js — el
// sitio funciona igual, solo que los eventos no llegan a GA4.
// Ver docs/ANALYTICS.md.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
---

{
  gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
      <script define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        // Se cuelga de window de forma explicita: trackEvent() (src/lib/analytics.ts) la llama como window.gtag.
        window.gtag = function () {
          dataLayer.push(arguments);
        };
        gtag("js", new Date());
        gtag("config", gaId);
      </script>
    </>
  )
}

{
  metaPixelId && (
    <script define:vars={{ metaPixelId }}>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = true;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = true;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
      fbq("init", metaPixelId);
      fbq("track", "PageView");
    </script>
  )
}

<script>
  import { initClickTracking, initViewTracking } from "../lib/analytics";
  initClickTracking();
  initViewTracking();
</script>
