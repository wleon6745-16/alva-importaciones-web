---
import { siteConfig } from "../lib/site-config";
import WhatsAppCTA from "./WhatsAppCTA.astro";
---

<div class="grid gap-6 sm:grid-cols-2">
  {
    siteConfig.locations.map((location) => (
      <div class="glass-card rounded-2xl p-6">
        <h3 class="font-display text-lg text-primary-800">
          <a href={`/locales/${location.slug}/`} class="hover:text-primary-600">
            {location.name}
          </a>
        </h3>
        <p class="mt-2 text-sm text-ink-muted">{location.address}</p>
        <a
          href={location.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block text-sm font-semibold text-primary-700 hover:underline"
          data-track-event="click_maps"
          data-track-source="location"
          data-track-branch={location.slug}
        >
          Ver en Google Maps →
        </a>
        <div class="mt-4">
          <WhatsAppCTA
            label={`WhatsApp ${location.name}`}
            number={location.whatsappNumber}
            class="!px-4 !py-2 text-sm"
            source="location"
            branch={location.slug}
          />
        </div>
      </div>
    ))
  }
</div>
