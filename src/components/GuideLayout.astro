---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionReveal from "../components/SectionReveal.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import { siteConfig } from "../lib/site-config";
import { articleSchema, breadcrumbSchema, faqSchema } from "../lib/structured-data";

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  intro: string;
  datePublished: string;
  faqs: Faq[];
  ctaMessage: string;
}

const { title, description, path, heading, intro, datePublished, faqs, ctaMessage } = Astro.props;

const pageUrl = new URL(path, siteConfig.url).toString();

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Guías", path: "/guias" },
  { name: heading, path },
]);

const article = articleSchema({
  headline: heading,
  description,
  pageUrl,
  datePublished,
});

const faqLd = faqSchema(faqs);

// `datePublished` es "YYYY-MM-DD". Se formatea con timeZone: "UTC" para que no se desplace un
// día al convertir a la zona horaria local del build (Date() interpreta "YYYY-MM-DD" como
// medianoche UTC, y sin fijar la zona de salida el formateo restaba un día en este entorno).
const publishedDate = new Date(datePublished).toLocaleDateString("es-EC", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout title={title} description={description} path={path} structuredData={[article, faqLd, breadcrumbs]}>
  <article>
    <nav aria-label="Breadcrumb" class="px-6 pt-8 text-sm text-ink-muted">
      <ol class="mx-auto flex max-w-3xl flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-primary-700">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/guias" class="hover:text-primary-700">Guías</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">{heading}</li>
      </ol>
    </nav>

    <section class="px-6 py-10 text-center">
      <div class="mx-auto max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Guía</p>
        <h1 class="mt-4 font-display text-4xl text-primary-900 sm:text-5xl">{heading}</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">{intro}</p>
        <p class="mt-4 text-xs uppercase tracking-wide text-ink-muted">
          Por {siteConfig.name} · Publicado el {publishedDate}
        </p>
      </div>
    </section>

    <slot />

    {
      faqs.length > 0 && (
        <SectionReveal as="section" class="px-6 py-16">
          <div class="mx-auto max-w-3xl">
            <h2 class="font-display text-2xl text-primary-900">Preguntas frecuentes</h2>
            <dl class="mt-8 space-y-6">
              {faqs.map((faq) => (
                <div>
                  <dt class="font-display text-lg text-primary-800">{faq.question}</dt>
                  <dd class="mt-2 text-ink-muted">{faq.answer}</dd>
                </div>
              ))}
            </dl>
          </div>
        </SectionReveal>
      )
    }

    <SectionReveal as="section" class="bg-blush-50 px-6 py-16 text-center">
      <h2 class="font-display text-2xl text-primary-900">¿Listo para equipar tu salón?</h2>
      <p class="mt-3 text-ink-muted">Consulta precio y disponibilidad por WhatsApp.</p>
      <WhatsAppCTA label="Consultar por WhatsApp" pulse class="mt-6" message={ctaMessage} source="guide" pageType="guide" ctaLocation="bottom" />
    </SectionReveal>
  </article>
</BaseLayout>
