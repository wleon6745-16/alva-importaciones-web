---
import WhatsAppCTA from "./WhatsAppCTA.astro";
import { siteConfig } from "../lib/site-config";

const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "Nosotros", href: "/nosotros" },
  { label: "Productos", href: "/productos" },
  { label: "Cursos", href: "/cursos" },
  { label: "Contacto", href: "/contacto" },
];
---

<header class="sticky top-0 z-50 border-b border-blush-100 bg-cream/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2">
      <img src="/brand/alva-icon-96.png" alt="" width="40" height="40" class="h-10 w-10" />
      <span class="flex flex-col leading-none">
        <span class="font-display text-2xl font-semibold tracking-wide text-ink">ALVA</span>
        <span class="hidden text-[0.65rem] uppercase tracking-[0.2em] text-ink-muted sm:inline">
          {siteConfig.tagline}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-sm font-medium text-ink hover:text-primary-800">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <WhatsAppCTA label="WhatsApp" class="hidden !px-4 !py-2 text-sm sm:inline-flex" />
      <details class="relative md:hidden">
        <summary class="list-none rounded-md p-2 hover:bg-blush-100" aria-label="Abrir menú">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
          </svg>
        </summary>
        <nav class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded-xl border border-blush-100 bg-white p-3 shadow-lg">
          {
            navLinks.map((link) => (
              <a href={link.href} class="rounded-md px-3 py-2 text-sm font-medium text-ink hover:bg-blush-100">
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
