---
import WhatsAppCTA from "./WhatsAppCTA.astro";
import { siteConfig } from "../lib/site-config";
import { categories } from "../lib/categories";

const staticLinks = [
  { label: "Nosotros", href: "/nosotros" },
  { label: "Guías", href: "/guias" },
  { label: "Cursos", href: "/cursos" },
  { label: "Contacto", href: "/contacto" },
];

// Mismo listado para el dropdown de escritorio y el panel móvil — ambos
// consumen categories/staticLinks, ninguno bifurca por nombre de categoría.
const allMobileLinks = [{ label: "Inicio", href: "/" }, ...staticLinks];
---

<header class="sticky top-0 z-50 border-b border-blush-100 bg-cream/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2">
      <img src="/brand/alva-icon-96.png" alt="" width="40" height="40" class="h-10 w-10" />
      <span class="flex flex-col leading-none">
        <span class="font-display text-2xl font-semibold tracking-wide text-ink">ALVA</span>
        <span class="hidden text-[0.65rem] uppercase tracking-[0.2em] text-ink-muted sm:inline">
          {siteConfig.tagline}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      <div class="relative">
        <button
          id="nav-productos-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="nav-productos-panel"
          class="group flex items-center gap-1 text-sm font-medium text-ink hover:text-primary-800"
        >
          Productos
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            class="mt-px transition-transform duration-200 group-aria-expanded:rotate-180"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div
          id="nav-productos-panel"
          role="menu"
          aria-label="Categorías de productos"
          class="invisible absolute left-1/2 top-full z-10 mt-3 w-72 -translate-x-1/2 translate-y-1 rounded-2xl border border-blush-100 bg-white p-2 opacity-0 shadow-xl transition-[opacity,transform,visibility] duration-200 ease-out"
        >
          {
            categories.map((category) => (
              <a
                role="menuitem"
                href={category.href}
                class="flex flex-col rounded-xl px-4 py-2.5 hover:bg-blush-50"
              >
                <span class="text-sm font-semibold text-ink">{category.shortLabel}</span>
                <span class="text-xs text-ink-muted">{category.description}</span>
              </a>
            ))
          }
          <a
            role="menuitem"
            href="/productos"
            class="mt-1 flex items-center justify-between rounded-xl border-t border-blush-100 px-4 py-2.5 pt-3 text-sm font-semibold text-primary-800 hover:bg-blush-50"
          >
            Ver todo el catálogo <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      {
        staticLinks.map((link) => (
          <a href={link.href} class="text-sm font-medium text-ink hover:text-primary-800">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <WhatsAppCTA label="WhatsApp" class="hidden !px-4 !py-2 text-sm sm:inline-flex" source="header" ctaLocation="header" />
      <button
        id="mobile-menu-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        class="rounded-md p-2 hover:bg-blush-100 md:hidden"
        aria-label="Abrir menú"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu-panel"
  class="pointer-events-none fixed inset-0 z-[60] opacity-0 transition-opacity duration-300"
  hidden
>
  <div id="mobile-menu-backdrop" class="absolute inset-0 bg-primary-900/50 backdrop-blur-sm"></div>
  <div class="absolute inset-y-0 right-0 flex w-[85vw] max-w-sm translate-x-full flex-col overflow-y-auto bg-cream px-6 pb-8 pt-5 shadow-2xl transition-transform duration-300 ease-out [#mobile-menu-panel.is-open_&]:translate-x-0">
    <div class="flex items-center justify-between">
      <span class="font-display text-xl text-ink">Menú</span>
      <button id="mobile-menu-close" type="button" class="rounded-md p-2 hover:bg-blush-100" aria-label="Cerrar menú">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <nav class="mt-6 flex flex-col gap-1" aria-label="Principal (móvil)">
      {
        allMobileLinks.map((link) => (
          <a href={link.href} class="rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-blush-100">
            {link.label}
          </a>
        ))
      }
    </nav>

    <p class="mt-6 px-3 text-xs font-semibold uppercase tracking-[0.2em] text-ink-muted">Categorías</p>
    <nav class="mt-2 flex flex-col gap-1" aria-label="Categorías (móvil)">
      {
        categories.map((category) => (
          <a href={category.href} class="rounded-lg px-3 py-2.5 text-base font-medium text-ink hover:bg-blush-100">
            {category.shortLabel}
          </a>
        ))
      }
    </nav>

    <div class="mt-auto pt-8">
      <WhatsAppCTA label="Chatea por WhatsApp" class="w-full justify-center" source="header" ctaLocation="mobile_menu" />
    </div>
  </div>
</div>

<style>
  #mobile-menu-panel.is-open {
    pointer-events: auto;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu-panel,
    #mobile-menu-panel > div {
      transition: none !important;
    }
  }
</style>

<script>
  // Dropdown de "Productos" (escritorio): boton + panel, no solo hover — para
  // que funcione igual con teclado y con mouse. Cierra con Escape, click
  // afuera, o al elegir un link.
  function setupDropdown() {
    const trigger = document.getElementById("nav-productos-trigger");
    const panel = document.getElementById("nav-productos-panel");
    if (!trigger || !panel) return;

    function open() {
      trigger?.setAttribute("aria-expanded", "true");
      panel?.classList.remove("invisible", "opacity-0", "translate-y-1");
    }
    function close() {
      trigger?.setAttribute("aria-expanded", "false");
      panel?.classList.add("invisible", "opacity-0", "translate-y-1");
    }
    function isOpen() {
      return trigger?.getAttribute("aria-expanded") === "true";
    }

    trigger.addEventListener("click", () => (isOpen() ? close() : open()));
    document.addEventListener("click", (event) => {
      if (isOpen() && !trigger.contains(event.target as Node) && !panel.contains(event.target as Node)) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        close();
        trigger.focus();
      }
    });
  }

  // Menu movil: overlay + panel deslizante, con scroll lock y devolucion de
  // foco al cerrar (mejor accesibilidad/sensacion premium que <details>).
  function setupMobileMenu() {
    const trigger = document.getElementById("mobile-menu-trigger");
    const closeBtn = document.getElementById("mobile-menu-close");
    const backdrop = document.getElementById("mobile-menu-backdrop");
    const panel = document.getElementById("mobile-menu-panel");
    if (!trigger || !panel || !closeBtn || !backdrop) return;

    function open() {
      panel!.hidden = false;
      // Un frame para que la transicion de opacity/translate se dispare.
      // setTimeout en vez de requestAnimationFrame: solo necesitamos que el
      // navegador procese el hidden=false antes de agregar la clase que
      // dispara la transicion (para que no "salte" sin animar); un timer de
      // macrotask cumple lo mismo sin depender del ciclo de pintado.
      setTimeout(() => panel!.classList.add("is-open"), 10);
      trigger!.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
      const firstLink = panel!.querySelector<HTMLAnchorElement>("nav a");
      firstLink?.focus();
    }
    function close() {
      panel!.classList.remove("is-open");
      trigger!.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      trigger!.focus();
      setTimeout(() => {
        if (!panel!.classList.contains("is-open")) panel!.hidden = true;
      }, 300);
    }

    trigger.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    panel.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && panel!.classList.contains("is-open")) close();
    });
  }

  setupDropdown();
  setupMobileMenu();
</script>
