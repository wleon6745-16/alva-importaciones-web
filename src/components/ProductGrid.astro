---
import { Image } from "astro:assets";

interface GridItem {
  slug: string;
  name: string;
  price?: number;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  items: GridItem[];
  basePath: string;
}

const { items, basePath } = Astro.props;

function priceLabel(item: GridItem): string {
  if (item.price === undefined) return "Consultar precio";
  const isWhole = Number.isInteger(item.price);
  return `$${item.price.toFixed(isWhole ? 0 : 2)}`;
}
---

<div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item) => (
      <a
        href={`${basePath}/${item.slug}/`}
        class="glass-card block overflow-hidden rounded-2xl shadow-md transition-transform duration-200 hover:-translate-y-1"
      >
        <div class="aspect-square overflow-hidden bg-white">
          <Image
            src={item.image}
            alt={item.imageAlt}
            width={400}
            height={400}
            class="h-full w-full object-contain"
          />
        </div>
        <div class="p-4">
          <h3 class="font-display text-base text-primary-800">{item.name}</h3>
          <p class="text-sm font-semibold text-ink">{priceLabel(item)}</p>
        </div>
      </a>
    ))
  }
</div>
