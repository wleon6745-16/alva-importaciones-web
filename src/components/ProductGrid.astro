---
import { Image } from "astro:assets";

interface GridItem {
  slug: string;
  name: string;
  price?: number;
  image: ImageMetadata;
  imageAlt: string;
}

interface Props {
  items: GridItem[];
  basePath: string;
}

const { items, basePath } = Astro.props;

function priceLabel(item: GridItem): string {
  if (item.price === undefined) return "Consultar precio";
  const isWhole = Number.isInteger(item.price);
  return `$${item.price.toFixed(isWhole ? 0 : 2)}`;
}
---

<div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item) => (
      <a
        href={`${basePath}/${item.slug}/`}
        class="group glass-card block overflow-hidden rounded-2xl shadow-md transition-[transform,box-shadow] duration-[var(--duration-base)] ease-[var(--ease-premium)] hover:-translate-y-1 hover:shadow-xl"
      >
        <div class="aspect-square overflow-hidden bg-white">
          <Image
            src={item.image}
            alt={item.imageAlt}
            width={400}
            height={400}
            class="media-zoom h-full w-full object-contain"
          />
        </div>
        <div class="flex flex-col gap-1 p-4">
          <h3 class="line-clamp-2 font-display text-lg leading-snug text-primary-800">{item.name}</h3>
          <div class="mt-1 flex items-center justify-between">
            <p class="text-sm font-semibold text-ink">{priceLabel(item)}</p>
            <span class="text-xs font-semibold text-primary-700 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
              Ver detalle →
            </span>
          </div>
        </div>
      </a>
    ))
  }
</div>
