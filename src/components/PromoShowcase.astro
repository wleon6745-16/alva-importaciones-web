---
// Muestra de campañas comerciales reales, curadas a mano desde el canal de Telegram del
// negocio (ver docs/CONTENT_WORKFLOW.md para el criterio de selección y cómo actualizar esta
// sección más adelante).
//
// Importante: estas son promociones YA PUBLICADAS en el pasado, no ofertas vigentes hoy — por
// eso el encabezado dice "así son nuestras promociones" y no "promociones de esta semana". El
// CTA principal de la sección manda a los canales donde sí se anuncian las promociones activas.
//
// Las gráficas de campaña originales (diseño con texto/precio superpuesto) no se muestran tal
// cual: en vez de eso, cada tarjeta usa una foto de producto limpia ya presente en el catálogo,
// con nuestro propio texto (mismo criterio de marca que el resto del sitio), para mantener
// consistencia visual — ver la sesión de calidad correspondiente para el detalle de esta
// decisión.
import { Image } from "astro:assets";
import mesaConcha from "../assets/products/muebles/mesa-silla-concha-manicura.jpg";
import drill from "../assets/products/unas/drill-inalambrico-master-nails.jpg";
import esmalte from "../assets/products/unas/esmalte-gelux-mia-secret.jpg";
import keratina from "../assets/products/capilares/keratina-ambroisie-250ml-rene-chardon.jpg";
import { siteConfig } from "../lib/site-config";

const promos = [
  {
    image: mesaConcha,
    alt: "Mesa de manicura con silla concha",
    label: "Combo Manicurista",
    body: "Mesa, silla concha, silla pequeña, puff de espera y reposamanos, con una lámpara UV/LED de regalo.",
  },
  {
    image: drill,
    alt: "Drill inalámbrico para uñas",
    label: "Drill + kit de regalo",
    body: "Por la compra de un drill de uñas, kit de esmaltes de regalo para tus diseños.",
  },
  {
    image: esmalte,
    alt: "Esmalte en gel para uñas",
    label: "Esmaltes: docena + 1 gratis",
    body: "Por la compra de tu docena de esmaltes, un esmalte adicional totalmente gratis.",
  },
  {
    image: keratina,
    alt: "Tratamiento capilar",
    label: "Activación capilar + facial",
    body: "Escaneo facial gratis, descuentos en skincare y asesoría personalizada en sucursal.",
  },
];
---

<div class="mx-auto max-w-6xl">
  <p class="text-center text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Así son nuestras promociones</p>
  <h2 class="mt-2 text-center font-display text-3xl text-primary-900 sm:text-4xl">Combos y campañas reales</h2>
  <p class="mx-auto mt-3 max-w-2xl text-center text-ink-muted">
    Una muestra de campañas que hemos compartido con nuestra comunidad. Las promociones cambian
    seguido — síguenos para no perderte las que están activas ahora mismo.
  </p>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      promos.map((promo) => (
        <div class="glass-card group flex flex-col overflow-hidden rounded-2xl shadow-md transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl">
          <div class="aspect-square overflow-hidden bg-white">
            <Image
              src={promo.image}
              alt={promo.alt}
              width={400}
              height={400}
              loading="lazy"
              class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="flex flex-1 flex-col gap-1 p-4">
            <p class="font-display text-base text-primary-900">{promo.label}</p>
            <p class="text-sm text-ink-muted">{promo.body}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-10 flex flex-wrap justify-center gap-4">
    <a
      href="https://whatsapp.com/channel/0029Vb6jnkrCRs1qmefXm93r"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-primary-800 px-6 py-3 font-semibold text-white transition-transform hover:scale-105 hover:bg-primary-700"
    >
      Seguir canal de WhatsApp →
    </a>
    <a
      href={siteConfig.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full border-2 border-primary-800 px-6 py-3 font-semibold text-primary-800 transition-transform hover:scale-105 hover:bg-primary-800 hover:text-white"
    >
      Seguir en Instagram →
    </a>
  </div>
</div>
