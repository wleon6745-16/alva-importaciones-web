---
// Bloque de promociones del Home.
//
// La fuente es Omviqa: ALVA crea, edita, ordena y apaga sus promociones desde
// el panel (/admin → Sitio web → Promociones). Las fichas de src/content/promos
// quedan solo como respaldo, para un build sin conexion a Omviqa o antes de
// que haya promociones publicadas alli.
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import PromotionsShowcase, { vigentes, type PromotionCard } from "./PromotionsShowcase.tsx";
import { siteConfig } from "../lib/site-config";
import { storefrontBaseUrl } from "../lib/storefront-config";
import { getOmviqaEditorial, type OmviqaPromotion } from "../lib/omviqa-editorial";

const WHATSAPP_CHANNEL = "https://whatsapp.com/channel/0029Vb6jnkrCRs1qmefXm93r";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/products/{muebles,unas,capilares,maquillaje}/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

async function respaldo(): Promise<PromotionCard[]> {
  const entries = (await getCollection("promos")).sort((a, b) => a.data.order - b.data.order);
  return Promise.all(
    entries.map(async (entry) => {
      const asset = images[`../assets/products/${entry.data.imageCategory}/${entry.data.image}`];
      const image = asset ? await getImage({ src: asset.default, width: 400, height: 400 }) : null;
      return {
        key: entry.id,
        title: entry.data.label,
        body: entry.data.body,
        imageUrl: image?.src ?? null,
        imageAlt: entry.data.imageAlt,
      };
    }),
  );
}

const publicadas = await getOmviqaEditorial<OmviqaPromotion>("promotion");
const initialItems = publicadas ? vigentes({ collection: publicadas }) : await respaldo();
---

<PromotionsShowcase
  client:load
  apiBaseUrl={storefrontBaseUrl() ?? ""}
  initialItems={initialItems}
  whatsappChannelUrl={WHATSAPP_CHANNEL}
  instagramUrl={siteConfig.instagram}
/>
