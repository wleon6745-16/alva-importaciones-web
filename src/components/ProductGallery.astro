---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<div class="overflow-hidden rounded-[2rem] border border-blush-100 bg-white p-8 shadow-lg sm:p-10">
  <div class="group aspect-square overflow-hidden">
    <Image
      src={image}
      alt={alt}
      width={800}
      height={800}
      densities={[1, 1.5, 2]}
      loading="eager"
      fetchpriority="high"
      class="media-zoom h-full w-full object-contain"
    />
  </div>
</div>
