---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
// Version grande para el zoom (sin pasar del tamano real de la foto).
const grande = await getImage({ src: image, width: Math.min(image.width, 1800), fit: "inside" });
// El marco se adapta a la forma de la foto: una foto ancha (sillones, camillas) en un cuadrado se ve chica, y una
// alta (butacas, sillas) necesita altura. Todas se ven completas; solo cambia el marco.
const forma = image.width / image.height;
const marco = forma >= 1.3 ? "aspect-[4/3]" : forma <= 0.75 ? "aspect-[4/5]" : "aspect-square";
---

<div class="overflow-hidden rounded-[2rem] border border-blush-100 bg-white p-8 shadow-lg sm:p-10">
  <div class:list={["group overflow-hidden", marco]}>
    <Image
      src={image}
      alt={alt}
      width={1100}
      height={1100}
      fit="inside"
      loading="eager"
      fetchpriority="high"
      data-zoom
      data-zoom-src={grande.src}
      class="media-zoom h-full w-full object-contain"
    />
  </div>
</div>
