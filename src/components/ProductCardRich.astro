---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WhatsAppCTA from "./WhatsAppCTA.astro";
import { siteConfig } from "../lib/site-config";

interface Props {
  slug: string;
  category: string;
  id: string;
  name: string;
  priceLabel: string;
  /** Se muestra solo la primera como bajada breve -- no una lista completa (ver detalle de producto para el resto). */
  features: string[];
  brand?: string;
  code?: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { slug, category, id, name, priceLabel, features, brand, code, image, imageAlt } = Astro.props;
const href = `/productos/${category}/${slug}/`;
---

<div class="group glass-card flex flex-col overflow-hidden rounded-2xl shadow-md transition-[transform,box-shadow] duration-[var(--duration-base)] ease-[var(--ease-premium)] hover:-translate-y-1 hover:shadow-xl">
  <a href={href} class="block">
    <div class="aspect-square overflow-hidden bg-white">
      <Image src={image} alt={imageAlt} width={500} height={500} class="media-zoom h-full w-full object-contain" />
    </div>
  </a>
  <div class="flex flex-1 flex-col gap-1.5 p-5">
    {brand && <p class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-700">{brand}</p>}
    <h3 class="font-display text-lg leading-snug text-primary-900">
      <a href={href} class="hover:text-primary-700">
        {name}
      </a>
    </h3>
    {features[0] && <p class="line-clamp-1 text-sm text-ink-muted">{features[0]}</p>}
    <p class="mt-1 text-xl font-semibold text-ink">{priceLabel}</p>
    <WhatsAppCTA
      label="Consultar"
      class="mt-3 w-fit !px-4 !py-2 text-sm"
      message={`Hola, quisiera consultar sobre: ${name}${code ? ` (Cód: ${code})` : ""} - ${new URL(href, siteConfig.url).toString()}`}
      productId={id}
      productName={name}
      category={category}
      source="product"
      pageType="category"
      ctaLocation="grid"
    />
  </div>
</div>
