---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WhatsAppCTA from "./WhatsAppCTA.astro";
import { siteConfig } from "../lib/site-config";

interface Props {
  slug: string;
  category: string;
  id: string;
  name: string;
  priceLabel: string;
  features: string[];
  code?: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { slug, category, id, name, priceLabel, features, code, image, imageAlt } = Astro.props;
const href = `/productos/${category}/${slug}/`;
---

<div class="group glass-card flex flex-col overflow-hidden rounded-2xl shadow-md transition-[box-shadow] duration-[var(--duration-base)] ease-[var(--ease-premium)] hover:shadow-xl">
  <a href={href} class="block">
    <div class="aspect-square overflow-hidden bg-white">
      <Image src={image} alt={imageAlt} width={500} height={500} class="media-zoom h-full w-full object-contain" />
    </div>
  </a>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <h3 class="font-display text-lg text-primary-800">
      <a href={href} class="hover:text-primary-600">
        {name}
      </a>
    </h3>
    <p class="text-xl font-semibold text-ink">{priceLabel}</p>
    {
      features.length > 0 && (
        <ul class="mt-1 space-y-1 text-sm text-ink-muted">
          {features.map((f) => (
            <li>• {f}</li>
          ))}
        </ul>
      )
    }
    {code && <p class="text-xs text-ink-muted">Cód: {code}</p>}
    <WhatsAppCTA
      label="Consultar"
      class="mt-auto !px-4 !py-2 text-sm"
      message={`Hola, quisiera consultar sobre: ${name} - ${new URL(href, siteConfig.url).toString()}`}
      productId={id}
      productName={name}
      category={category}
      source="product"
      pageType="category"
      ctaLocation="grid"
    />
  </div>
</div>
