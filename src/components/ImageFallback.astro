---
// Foto rota => cuadro "Foto próximamente", en TODO el sitio.
//
// Las fotos del catalogo viven en el servidor de Omviqa. Si una se pierde o tarda en subirse, el navegador
// dibujaba el texto alternativo suelto y un icono roto, y la tarjeta quedaba "caida" (pasaba con el
// VNC828). En vez de arreglar producto por producto, cualquier <img> de la pagina principal que falle al
// cargar se reemplaza por un cuadro del mismo tamano, sin romper la grilla. Sirve igual para las islas de
// React (ya hidratadas o por hidratar), porque escucha en la captura del documento.
---

<style is:global>
  .img-fallback {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 6rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--color-blush-50);
    color: color-mix(in srgb, var(--color-primary-700) 55%, transparent);
    font-size: 0.8rem;
    font-weight: 500;
    text-align: center;
  }
</style>

<script is:inline>
  (function () {
    var ICON =
      '<svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><span>Foto próximamente</span>';

    function reemplazar(img) {
      if (!img || img.tagName !== "IMG" || img.getAttribute("data-fallback-done")) return;
      if (img.hasAttribute("data-no-fallback") || !img.closest("main")) return;
      var caja = document.createElement("div");
      caja.className = "img-fallback";
      caja.setAttribute("role", "img");
      caja.setAttribute("aria-label", (img.alt || "Producto") + " (foto próximamente)");
      caja.innerHTML = ICON;
      img.setAttribute("data-fallback-done", "1");
      if (img.parentNode) img.parentNode.replaceChild(caja, img);
    }

    // 'error' no burbujea, pero si se captura en el documento.
    document.addEventListener("error", function (e) { reemplazar(e.target); }, true);

    // Las que ya fallaron antes de que este script corriera.
    function revisar() {
      document.querySelectorAll("main img").forEach(function (img) {
        var src = img.getAttribute("src") || "";
        if (img.complete && img.naturalWidth === 0 && src && !/\.svg(\?|$)/i.test(src)) reemplazar(img);
      });
    }
    if (document.readyState === "complete") revisar();
    else window.addEventListener("load", revisar);
  })();
</script>
