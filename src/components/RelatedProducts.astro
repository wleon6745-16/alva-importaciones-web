---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface RelatedItem {
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  name: string;
  priceLabel: string;
}

interface Props {
  items: RelatedItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <a
          href={item.href}
          class="group glass-card block overflow-hidden rounded-2xl shadow-md transition-[transform,box-shadow] duration-[var(--duration-base)] ease-[var(--ease-premium)] hover:-translate-y-1 hover:shadow-xl"
        >
          <div class="aspect-square overflow-hidden bg-white">
            <Image
              src={item.image}
              alt={item.imageAlt}
              width={400}
              height={400}
              class="media-zoom h-full w-full object-contain"
            />
          </div>
          <div class="p-4">
            <h3 class="line-clamp-2 font-display text-base text-primary-800">{item.name}</h3>
            <p class="mt-1 text-sm font-semibold text-ink">{item.priceLabel}</p>
          </div>
        </a>
      ))}
    </div>
  )
}
