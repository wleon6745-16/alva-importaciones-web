---
import WhatsAppCTA from "./WhatsAppCTA.astro";
import { siteConfig } from "../lib/site-config";
import { editorialAssetUrl, type OmviqaEditorialCollection, type OmviqaPromotion } from "../lib/omviqa-editorial";

interface Props {
  collection: OmviqaEditorialCollection<OmviqaPromotion>;
}

const { collection } = Astro.props;
const promos = [...collection.items]
  .filter((item) => item.payload.enabled !== false)
  .sort((a, b) => (a.payload.sortOrder ?? 10000) - (b.payload.sortOrder ?? 10000));
---

<div class="mx-auto max-w-6xl">
  <p class="text-center text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Promociones</p>
  <h2 class="mt-2 text-center font-display text-3xl text-primary-900 sm:text-4xl">Campañas destacadas</h2>
  <p class="mx-auto mt-3 max-w-2xl text-center text-ink-muted">
    Revisa campañas y anuncios destacados. Precio y disponibilidad final se confirman por WhatsApp.
  </p>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      promos.map((promo) => {
        const image = editorialAssetUrl(promo.payload, collection.assets);
        return (
          <div class="glass-card group flex flex-col overflow-hidden rounded-2xl shadow-md transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl">
            <div class="aspect-square overflow-hidden bg-white">
              {image ? (
                <img src={image} alt={promo.payload.imageAlt || promo.payload.title} loading="lazy" class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105" />
              ) : (
                <div class="h-full w-full bg-blush-50"></div>
              )}
            </div>
            <div class="flex flex-1 flex-col gap-1 p-4">
              <p class="font-display text-base text-primary-900">{promo.payload.title}</p>
              <p class="text-sm text-ink-muted">{promo.payload.body}</p>
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="mt-10 flex flex-wrap justify-center gap-4">
    <a
      href="https://whatsapp.com/channel/0029Vb6jnkrCRs1qmefXm93r"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full bg-primary-800 px-6 py-3 font-semibold text-white transition-transform hover:scale-105 hover:bg-primary-700"
    >
      Seguir canal de WhatsApp →
    </a>
    <a
      href={siteConfig.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full border-2 border-primary-800 px-6 py-3 font-semibold text-primary-800 transition-transform hover:scale-105 hover:bg-primary-800 hover:text-white"
    >
      Seguir en Instagram →
    </a>
  </div>
</div>
