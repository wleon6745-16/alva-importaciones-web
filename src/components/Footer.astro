---
import { siteConfig } from "../lib/site-config";

const year = new Date().getFullYear();
---

<footer class="bg-primary-900 text-blush-50">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 md:grid-cols-4">
    <div>
      <div class="flex items-center gap-2">
        <img src="/brand/alva-icon-dark-96.png" alt="" width="36" height="36" class="h-9 w-9" />
        <span class="font-display text-2xl font-semibold tracking-wide text-white">ALVA</span>
      </div>
      <p class="mt-2 text-xs uppercase tracking-[0.2em] text-blush-100/70">{siteConfig.tagline}</p>
      <p class="mt-4 text-sm text-blush-100/80">{siteConfig.description}</p>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-blush-100/70">Navegación</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/nosotros" class="hover:text-white">Nosotros</a></li>
        <li><a href="/productos" class="hover:text-white">Productos</a></li>
        <li><a href="/cursos" class="hover:text-white">Cursos</a></li>
        <li><a href="/contacto" class="hover:text-white">Contacto</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-blush-100/70">Horario</h4>
      <ul class="mt-4 space-y-2 text-sm text-blush-100/80">
        {siteConfig.hours.map((h) => (
          <li>{h.days}: {h.time}</li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wide text-blush-100/70">Síguenos</h4>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href={siteConfig.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-white">
            Instagram
          </a>
        </li>
        <li>
          <a href="/privacidad" class="hover:text-white">Privacidad</a>
        </li>
        <li>
          <a href="/terminos" class="hover:text-white">Términos</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 px-6 py-6 text-center text-xs text-blush-100/60">
    © {year} {siteConfig.name}. Todos los derechos reservados.
  </div>
</footer>
