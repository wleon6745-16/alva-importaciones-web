---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { resolveSeo, type SeoProps } from "../lib/seo";
import { organizationSchema } from "../lib/structured-data";
import Analytics from "../components/Analytics.astro";
import { storefrontBaseUrl } from "../lib/storefront-config";
import { PRECIO_OCULTO } from "../lib/price-visibility";
import AssistantWidget from "../components/AssistantWidget.tsx";
import { assistantEndpoint } from "../lib/assistant-config";
import { whatsappLink } from "../lib/site-config";

const precioApi = storefrontBaseUrl();
const asistente = assistantEndpoint();
const asistenteWhatsapp = whatsappLink("Hola, vengo del asistente de la web y quisiera hablar con una asesora");

interface Props extends SeoProps {
  structuredData?: object[];
}

const { structuredData = [], ...seoProps } = Astro.props;
const seo = resolveSeo(seoProps);
const schemas = [organizationSchema(), ...structuredData];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={seo.canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonicalUrl} />
    <meta property="og:image" content={seo.imageUrl} />
    <meta property="og:locale" content="es_EC" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.imageUrl} />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    {/*
      Asistente de Alva (Web Channel de Omviqa). client:idle: no compite con el
      primer render ni con el LCP; el boton flotante aparece cuando el navegador
      queda libre.
    */}
    {asistente && <AssistantWidget client:idle endpoint={asistente} whatsappUrl={asistenteWhatsapp} />}
    {/*
      Precios ocultos al instante: si ALVA los apaga en Omviqa, cualquier precio
      escrito en estas paginas (marcado con data-precio) se reemplaza sin
      esperar a un nuevo build. Los precios que vienen de la API ya llegan
      vacios desde el servidor.
    */}
    {precioApi && (
      <script is:inline define:vars={{ precioApi, textoOculto: PRECIO_OCULTO }}>
        fetch(precioApi + "/settings", { cache: "no-store" })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) {
            if (!d || !d.settings || d.settings.showPrices !== false) return;
            window.__alvaShowPrices = false;
            document.querySelectorAll("[data-precio]").forEach(function (el) {
              el.textContent = textoOculto;
            });
          })
          .catch(function () {});
      </script>
    )}
  </body>
</html>
