---
import { getImage } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionReveal from "../../../components/SectionReveal.astro";
import ProductGallery from "../../../components/ProductGallery.astro";
import ProductActionPanel from "../../../components/ProductActionPanel.astro";
import RelatedProducts from "../../../components/RelatedProducts.astro";
import ViewProductTracker from "../../../components/ViewProductTracker.astro";
import { breadcrumbSchema, productSchema } from "../../../lib/structured-data";
import { siteConfig } from "../../../lib/site-config";
import { getProductsByCategory } from "../../../lib/products";
import type { Product } from "../../../types/product";

// `getStaticPaths` runs in module scope at build time, separate from the rest of this
// frontmatter (which runs per-render) — it can't close over a `const` declared out here,
// only over imports/awaited calls made inside itself. So the muebles list is (re)fetched
// independently in each scope.
export async function getStaticPaths() {
  const muebles = await getProductsByCategory("muebles");
  return muebles.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const muebles = await getProductsByCategory("muebles");

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../../assets/products/muebles/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

function imageFor(filename: string): ImageMetadata {
  const entry = images[`../../../assets/products/muebles/${filename}`];
  if (!entry) throw new Error(`Imagen no encontrada para: ${filename}`);
  return entry.default;
}

function priceLabel(p: Product): string {
  if (p.price === undefined) return "Consultar precio";
  const isWhole = Number.isInteger(p.price);
  return `$${p.price.toFixed(isWhole ? 0 : 2)}`;
}

const SUBCATEGORY_TITLES: Record<string, string> = {
  camillas: "Camillas",
  "sillones-y-sillas-de-peluqueria-barberia": "Sillones y sillas de peluquería / barbería",
  "butacas-y-sillas": "Butacas y sillas",
  "mesas-de-trabajo": "Mesas de trabajo",
  "equipo-y-accesorios-de-salon": "Equipo y accesorios de salón",
};

const related = muebles
  .filter((p) => p.subcategory === product.subcategory && p.slug !== product.slug)
  .slice(0, 4);

const pagePath = `/productos/muebles/${product.slug}/`;
const pageUrl = new URL(pagePath, siteConfig.url).toString();

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Productos", path: "/productos" },
  { name: "Muebles", path: "/productos/muebles" },
  { name: product.name, path: pagePath },
]);

const description = `${product.name}. ${product.features.slice(0, 2).join(", ")}. Precio: ${priceLabel(
  product,
)}. Consulta disponibilidad por WhatsApp en Portoviejo, Manabí.`;

// Varios productos comparten el mismo nombre exacto (p. ej. 4 "Sillón de peluquería" sin código
// ni modelo distinto en el nombre) — el <title> tiene que ser único aunque el nombre visible del
// producto se mantenga igual, así que se desambigua con el precio solo cuando hace falta.
const sameNameCount = muebles.filter((p) => p.name === product.name).length;
const pageTitle = sameNameCount > 1 ? `${product.name} - ${priceLabel(product)}` : product.name;

const optimizedImage = await getImage({ src: imageFor(product.image), width: 1200, height: 1200 });
const imageUrl = new URL(optimizedImage.src, siteConfig.url).toString();

const productLd = productSchema(product, pageUrl, imageUrl);
---

<BaseLayout
  title={pageTitle}
  description={description}
  path={pagePath}
  image={optimizedImage.src}
  structuredData={[breadcrumbs, productLd]}
>
  <nav aria-label="Breadcrumb" class="px-6 pt-8 text-sm text-ink-muted">
    <ol class="mx-auto flex max-w-6xl flex-wrap items-center gap-2">
      <li><a href="/" class="hover:text-primary-700">Inicio</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/productos" class="hover:text-primary-700">Productos</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/productos/muebles" class="hover:text-primary-700">Muebles</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink">{product.name}</li>
    </ol>
  </nav>

  <SectionReveal as="section" class="px-6 py-10">
    <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-2 md:items-start">
      <ProductGallery image={imageFor(product.image)} alt={product.imageAlt} />
      <ProductActionPanel
        eyebrow={SUBCATEGORY_TITLES[product.subcategory ?? ""] ?? "Muebles"}
        name={product.name}
        priceLabel={priceLabel(product)}
        code={product.code}
        features={product.features}
        whatsappMessage={`Hola, quisiera consultar sobre: ${product.name}${product.code ? ` (Cód: ${product.code})` : ""} - ${pageUrl}`}
        productId={product.id}
        productName={product.name}
        category={product.category}
      />
    </div>
  </SectionReveal>

  {
    related.length > 0 && (
      <SectionReveal as="section" class="bg-blush-50 px-6 py-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-2xl text-primary-900">También te puede interesar</h2>
          <RelatedProducts
            items={related.map((item) => ({
              href: `/productos/muebles/${item.slug}/`,
              image: imageFor(item.image),
              imageAlt: item.imageAlt,
              name: item.name,
              priceLabel: priceLabel(item),
            }))}
          />
        </div>
      </SectionReveal>
    )
  }

  <ViewProductTracker
    productCode={product.code ?? product.id}
    productName={product.name}
    category={product.category}
    brand={product.brand}
  />
</BaseLayout>
