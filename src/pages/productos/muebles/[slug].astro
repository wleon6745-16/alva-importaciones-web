---
import { Image } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionReveal from "../../../components/SectionReveal.astro";
import WhatsAppCTA from "../../../components/WhatsAppCTA.astro";
import { breadcrumbSchema } from "../../../lib/structured-data";
import type { Product } from "../../../types/product";
import productsData from "../../../data/products.generated.json";

// `getStaticPaths` runs in module scope at build time, separate from the rest of this
// frontmatter (which runs per-render) — it can't close over a `const` declared out here,
// only over imports. So the muebles list is (re)computed independently in each scope.
export function getStaticPaths() {
  const muebles = (productsData.products as Product[]).filter((p) => p.category === "muebles");
  return muebles.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const muebles = (productsData.products as Product[]).filter((p) => p.category === "muebles");

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../../assets/products/muebles/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

function imageFor(filename: string): ImageMetadata {
  const entry = images[`../../../assets/products/muebles/${filename}`];
  if (!entry) throw new Error(`Imagen no encontrada para: ${filename}`);
  return entry.default;
}

function priceLabel(p: Product): string {
  if (p.price === undefined) return "Consultar precio";
  const isWhole = Number.isInteger(p.price);
  return `$${p.price.toFixed(isWhole ? 0 : 2)}`;
}

const SUBCATEGORY_TITLES: Record<string, string> = {
  camillas: "Camillas",
  "sillones-y-sillas-de-peluqueria-barberia": "Sillones y sillas de peluquería / barbería",
  "butacas-y-sillas": "Butacas y sillas",
  "mesas-de-trabajo": "Mesas de trabajo",
  "equipo-y-accesorios-de-salon": "Equipo y accesorios de salón",
};

const related = muebles
  .filter((p) => p.subcategory === product.subcategory && p.slug !== product.slug)
  .slice(0, 4);

const pagePath = `/productos/muebles/${product.slug}/`;

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Productos", path: "/productos" },
  { name: "Muebles", path: "/productos/muebles" },
  { name: product.name, path: pagePath },
]);

const description = `${product.name}. ${product.features.slice(0, 2).join(", ")}. Precio: ${priceLabel(
  product,
)}. Consulta disponibilidad por WhatsApp en Portoviejo, Manabí.`;
---

<BaseLayout
  title={product.name}
  description={description}
  path={pagePath}
  structuredData={[breadcrumbs]}
>
  <nav aria-label="Breadcrumb" class="px-6 pt-8 text-sm text-ink-muted">
    <ol class="mx-auto flex max-w-6xl flex-wrap items-center gap-2">
      <li><a href="/" class="hover:text-primary-700">Inicio</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/productos" class="hover:text-primary-700">Productos</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/productos/muebles" class="hover:text-primary-700">Muebles</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink">{product.name}</li>
    </ol>
  </nav>

  <SectionReveal as="section" class="px-6 py-10">
    <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-2">
      <div class="glass-card overflow-hidden rounded-2xl bg-white p-6">
        <div class="aspect-square overflow-hidden">
          <Image
            src={imageFor(product.image)}
            alt={product.imageAlt}
            width={800}
            height={800}
            class="h-full w-full object-contain"
          />
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-700">
          {SUBCATEGORY_TITLES[product.subcategory ?? ""] ?? "Muebles"}
        </p>
        <h1 class="font-display text-3xl text-primary-900 sm:text-4xl">{product.name}</h1>
        <p class="text-2xl font-semibold text-ink">{priceLabel(product)}</p>
        {product.code && <p class="text-sm text-ink-muted">Código: {product.code}</p>}
        {
          product.features.length > 0 && (
            <div>
              <h2 class="font-display text-lg text-primary-800">Características</h2>
              <ul class="mt-2 space-y-1 text-ink-muted">
                {product.features.map((f) => (
                  <li>• {f}</li>
                ))}
              </ul>
            </div>
          )
        }
        <WhatsAppCTA
          label="Consultar por WhatsApp"
          pulse
          class="mt-2 w-fit"
          message={`Hola, quisiera consultar sobre: ${product.name}${product.code ? ` (Cód: ${product.code})` : ""}`}
        />
      </div>
    </div>
  </SectionReveal>

  {
    related.length > 0 && (
      <SectionReveal as="section" class="bg-blush-50 px-6 py-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-2xl text-primary-900">También te puede interesar</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((item) => (
              <a
                href={`/productos/muebles/${item.slug}/`}
                class="glass-card block overflow-hidden rounded-2xl shadow-md transition-transform duration-200 hover:-translate-y-1"
              >
                <div class="aspect-square overflow-hidden bg-white">
                  <Image
                    src={imageFor(item.image)}
                    alt={item.imageAlt}
                    width={400}
                    height={400}
                    class="h-full w-full object-contain"
                  />
                </div>
                <div class="p-4">
                  <h3 class="font-display text-base text-primary-800">{item.name}</h3>
                  <p class="text-sm font-semibold text-ink">{priceLabel(item)}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </SectionReveal>
    )
  }
</BaseLayout>
