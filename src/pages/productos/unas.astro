---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionReveal from "../../components/SectionReveal.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import RelatedCategories from "../../components/RelatedCategories.astro";
import { breadcrumbSchema } from "../../lib/structured-data";
import { siteConfig } from "../../lib/site-config";
import { getProductsByCategory } from "../../lib/products";
import type { Product } from "../../types/product";

const products = await getProductsByCategory("unas");

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/products/unas/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
function imageFor(filename: string): ImageMetadata {
  const entry = images[`../../assets/products/unas/${filename}`];
  if (!entry) throw new Error(`Imagen no encontrada para: ${filename}`);
  return entry.default;
}

function priceLabel(product: Product): string {
  if (product.price === undefined) return "Consultar precio";
  const isWhole = Number.isInteger(product.price);
  return `$${product.price.toFixed(isWhole ? 0 : 2)}`;
}

const SUBCATEGORY_TITLES: Record<string, string> = {
  "acrilicos-y-monomeros": "Acrílicos y monómeros",
  esmaltes: "Esmaltes",
  "herramientas-y-equipo": "Herramientas y equipo",
};
const SUBCATEGORY_ORDER = Object.keys(SUBCATEGORY_TITLES);

const sections = SUBCATEGORY_ORDER.map((subcategory) => ({
  subcategory,
  title: SUBCATEGORY_TITLES[subcategory],
  items: products.filter((p) => p.subcategory === subcategory),
})).filter((section) => section.items.length > 0);

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Productos", path: "/productos" },
  { name: "Uñas", path: "/productos/unas" },
]);
---

<BaseLayout
  title="Insumos de Uñas y Nailart"
  description="Acrílicos, geles, esmaltes y todo lo necesario para nail art profesional en Portoviejo. Precio y stock por WhatsApp."
  path="/productos/unas"
  structuredData={[breadcrumbs]}
>
  <section class="hero-glow px-6 py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Categoría</p>
    <h1 class="mt-4 font-display text-4xl text-primary-900">Uñas / Nailart</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
      Monómeros, acrílicos, geles, esmaltes y accesorios de marcas como Master Nails y Mia
      Secret.
    </p>
    <WhatsAppCTA label="Consultar por WhatsApp" pulse class="mt-8" message="Hola, quisiera consultar sobre productos de uñas" source="category" pageType="category" category="unas" ctaLocation="hero" />
  </section>

  {
    sections.map((section) => (
      <SectionReveal as="section" id={section.subcategory} class="scroll-mt-24 px-6 py-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-3xl text-primary-900">{section.title}</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {section.items.map((item) => (
              <div class="glass-card flex flex-col overflow-hidden rounded-2xl shadow-md">
                <a href={`/productos/unas/${item.slug}/`} class="block">
                  <div class="aspect-square overflow-hidden bg-white">
                    <Image
                      src={imageFor(item.image)}
                      alt={item.imageAlt}
                      width={500}
                      height={500}
                      class="h-full w-full object-contain"
                    />
                  </div>
                </a>
                <div class="flex flex-1 flex-col gap-2 p-5">
                  <h3 class="font-display text-lg text-primary-800">
                    <a href={`/productos/unas/${item.slug}/`} class="hover:text-primary-600">
                      {item.name}
                    </a>
                  </h3>
                  <p class="text-xl font-semibold text-ink">{priceLabel(item)}</p>
                  {item.features.length > 0 && (
                    <ul class="mt-1 space-y-1 text-sm text-ink-muted">
                      {item.features.map((f) => (
                        <li>• {f}</li>
                      ))}
                    </ul>
                  )}
                  {item.code && <p class="text-xs text-ink-muted">Cód: {item.code}</p>}
                  <WhatsAppCTA
                    label="Consultar"
                    class="mt-auto !px-4 !py-2 text-sm"
                    message={`Hola, quisiera consultar sobre: ${item.name} - ${new URL(`/productos/unas/${item.slug}/`, siteConfig.url).toString()}`}
                    productId={item.id}
                    productName={item.name}
                    category={item.category}
                    source="product"
                    pageType="category"
                    ctaLocation="grid"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      </SectionReveal>
    ))
  }

  <SectionReveal as="section" class="bg-blush-50 px-6 py-16 text-center">
    <h2 class="font-display text-2xl text-primary-900">¿No encuentras lo que buscas?</h2>
    <p class="mt-3 text-ink-muted">Seguimos ampliando el catálogo de uñas — pregúntanos por WhatsApp.</p>
    <WhatsAppCTA label="Consultar por WhatsApp" class="mt-6" message="Hola, quisiera consultar sobre productos de uñas" source="category" pageType="category" category="unas" ctaLocation="bottom" />
    <a href="/productos-para-unas-portoviejo" class="mt-4 inline-block text-sm font-semibold text-primary-700 hover:underline">
      Ver también: productos para uñas en Portoviejo →
    </a>
  </SectionReveal>

  <SectionReveal as="section" class="px-6 py-16 text-center">
    <RelatedCategories current="unas" />
  </SectionReveal>
</BaseLayout>
