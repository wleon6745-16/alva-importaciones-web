---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionReveal from "../../components/SectionReveal.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import CategoryClosingCTA from "../../components/CategoryClosingCTA.astro";
import ProductCardRich from "../../components/ProductCardRich.astro";
import CatalogExplorer from "../../components/CatalogExplorer.tsx";
import { breadcrumbSchema } from "../../lib/structured-data";
import { siteConfig } from "../../lib/site-config";
import { getProductsByCategory } from "../../lib/products";
import { getEntry } from "astro:content";
import { storefrontApiUrl, storefrontChannelId } from "../../lib/storefront-config";
import type { Product } from "../../types/product";

const CATEGORY_SLUG = "unas";
const products = await getProductsByCategory("unas");

// Catálogo completo real (SACC vía Storefront API), aparte de la selección
// curada de arriba -- ver src/lib/storefront-config.ts y scripts/fetch-
// storefront-snapshot.ts. Se excluyen por código los productos que ya están
// en la selección curada, para no mostrar la misma pieza dos veces con dos
// tratamientos visuales distintos.
const storefrontEntry = await getEntry("storefrontCatalog", CATEGORY_SLUG);
const curatedCodes = new Set(products.map((p) => p.code).filter((c): c is string => Boolean(c)));
const fullCatalogItems = (storefrontEntry?.data.firstPage ?? []).filter(
  (item) => !item.code || !curatedCodes.has(item.code)
);
const fullCatalogHasMore = Boolean(
  storefrontEntry && storefrontEntry.data.firstPageTotal > storefrontEntry.data.firstPage.length
);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/products/unas/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
function imageFor(filename: string): ImageMetadata {
  const entry = images[`../../assets/products/unas/${filename}`];
  if (!entry) throw new Error(`Imagen no encontrada para: ${filename}`);
  return entry.default;
}

function priceLabel(product: Product): string {
  if (product.price === undefined) return "Consultar precio";
  const isWhole = Number.isInteger(product.price);
  return `$${product.price.toFixed(isWhole ? 0 : 2)}`;
}

const SUBCATEGORY_TITLES: Record<string, string> = {
  "acrilicos-y-monomeros": "Acrílicos y monómeros",
  esmaltes: "Esmaltes",
  "herramientas-y-equipo": "Herramientas y equipo",
};
const SUBCATEGORY_ORDER = Object.keys(SUBCATEGORY_TITLES);

const sections = SUBCATEGORY_ORDER.map((subcategory) => ({
  subcategory,
  title: SUBCATEGORY_TITLES[subcategory],
  items: products.filter((p) => p.subcategory === subcategory),
})).filter((section) => section.items.length > 0);

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Productos", path: "/productos" },
  { name: "Uñas", path: "/productos/unas" },
]);
---

<BaseLayout
  title="Insumos de Uñas y Nailart"
  description="Acrílicos, geles, esmaltes y todo lo necesario para nail art profesional en Portoviejo. Precio y stock por WhatsApp."
  path="/productos/unas"
  structuredData={[breadcrumbs]}
>
  <section class="hero-glow px-6 py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Categoría</p>
    <h1 class="mt-4 font-display text-4xl text-primary-900">Uñas / Nailart</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
      Monómeros, acrílicos, geles, esmaltes y accesorios de marcas como Master Nails y Mia
      Secret.
    </p>
    <WhatsAppCTA label="Consultar por WhatsApp" pulse class="mt-8" message="Hola, quisiera consultar sobre productos de uñas" source="category" pageType="category" category="unas" ctaLocation="hero" />
  </section>

  {
    sections.map((section) => (
      <SectionReveal as="section" id={section.subcategory} class="scroll-mt-24 px-6 py-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-3xl text-primary-900">{section.title}</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {section.items.map((item) => (
              <ProductCardRich
                slug={item.slug}
                category={item.category}
                id={item.id}
                name={item.name}
                priceLabel={priceLabel(item)}
                features={item.features}
                brand={item.brand}
                code={item.code}
                image={imageFor(item.image)}
                imageAlt={item.imageAlt}
              />
            ))}
          </div>
        </div>
      </SectionReveal>
    ))
  }

  {
    storefrontEntry && (
      <SectionReveal as="section" class="px-6 py-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-3xl text-primary-900">Todo el catálogo de Uñas</h2>
          <p class="mt-2 max-w-2xl text-ink-muted">
            Además de nuestra selección destacada, este es el catálogo completo real —{" "}
            {storefrontEntry.data.productCount.toLocaleString("es-EC")} productos con precio público.
          </p>
          <div class="mt-8">
            <CatalogExplorer
              client:visible
              apiBaseUrl={storefrontApiUrl}
              channelId={storefrontChannelId}
              categorySlug={CATEGORY_SLUG}
              initialItems={fullCatalogItems}
              initialBrands={storefrontEntry.data.brands}
              initialTotal={storefrontEntry.data.firstPageTotal}
              initialHasMore={fullCatalogHasMore}
            />
          </div>
        </div>
      </SectionReveal>
    )
  }

  <SectionReveal as="section" class="bg-blush-50 px-6 py-14">
    <CategoryClosingCTA
      current="unas"
      description="Seguimos ampliando el catálogo de uñas — pregúntanos por WhatsApp."
      whatsappMessage="Hola, quisiera consultar sobre productos de uñas"
      extraLink={{ href: "/productos-para-unas-portoviejo", label: "Ver también: productos para uñas en Portoviejo" }}
    />
  </SectionReveal>
</BaseLayout>
