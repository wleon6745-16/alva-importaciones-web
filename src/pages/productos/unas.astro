---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionReveal from "../../components/SectionReveal.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import CategoryClosingCTA from "../../components/CategoryClosingCTA.astro";
import CatalogExplorer from "../../components/CatalogExplorer.tsx";
import CategorySearchBar from "../../components/CategorySearchBar.tsx";
import { breadcrumbSchema } from "../../lib/structured-data";
import { siteConfig } from "../../lib/site-config";
import { getEntry } from "astro:content";
import { storefrontApiUrl, storefrontBaseUrl, storefrontChannelId } from "../../lib/storefront-config";
import CategoryHighlights from "../../components/CategoryHighlights.tsx";
import { hasMoreProducts } from "../../lib/storefront-snapshot";

const CATEGORY_SLUG = "unas";

// Catálogo real (SACC vía Storefront API) -- ver src/lib/storefront-config.ts y
// scripts/fetch-storefront-snapshot.ts. Antes esta página tenía además tarjetas de producto escritas
// a mano en src/content/products/unas (Esmaltes, Acrílicos, Herramientas): quedaron viejas, con
// productos en la subcategoría equivocada, y duplicaban lo que el catálogo ya trae. Ahora la página
// sigue el mismo patrón que el resto de categorías: destacados del canal + catálogo en vivo.
const storefrontEntry = await getEntry("storefrontCatalog", CATEGORY_SLUG);
const fullCatalogItems = storefrontEntry?.data.firstPage ?? [];
const fullCatalogHasMore = Boolean(
  storefrontEntry && hasMoreProducts(storefrontEntry.data)
);

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Productos", path: "/productos" },
  { name: "Uñas", path: "/productos/unas" },
]);
---

<BaseLayout
  title="Insumos de Uñas y Nailart"
  description="Acrílicos, geles, esmaltes y todo lo necesario para nail art profesional en Portoviejo. Precio y stock por WhatsApp."
  path="/productos/unas"
  structuredData={[breadcrumbs]}
>
  <section class="hero-glow px-6 py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Categoría</p>
    <h1 class="mt-4 font-display text-4xl text-primary-900">Uñas / Nailart</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
      Monómeros, acrílicos, geles, esmaltes y accesorios de marcas como Master Nails y Mia
      Secret.
    </p>
    <WhatsAppCTA label="Consultar por WhatsApp" pulse class="mt-8" message="Hola, quisiera consultar sobre productos de uñas" source="category" pageType="category" category="unas" ctaLocation="hero" />
  </section>

  <CategorySearchBar client:load categorySlug="unas" categoryLabel="Uñas" />

  <CategoryHighlights
    client:load
    apiBaseUrl={storefrontBaseUrl() ?? ""}
    categorySlug="unas"
    categoryLabel="Uñas"
    initialItems={storefrontEntry?.data.highlights ?? []}
  />

  {
    storefrontEntry && (
      <SectionReveal as="section" id="catalogo" class="scroll-mt-24 px-6 py-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-3xl text-primary-900">Todo el catálogo de Uñas</h2>
          <p class="mt-2 max-w-2xl text-ink-muted">
            Además de nuestra selección destacada, aquí puedes explorar el resto de la categoría.
          </p>
          <div class="mt-8">
            <CatalogExplorer
              client:idle
              apiBaseUrl={storefrontApiUrl}
              channelId={storefrontChannelId}
              categorySlug={CATEGORY_SLUG}
              initialItems={fullCatalogItems}
              initialBrands={storefrontEntry.data.brands}
              initialTotal={0}
              initialHasMore={fullCatalogHasMore}
            />
          </div>
        </div>
      </SectionReveal>
    )
  }

  <SectionReveal as="section" class="bg-blush-50 px-6 py-14">
    <CategoryClosingCTA
      current="unas"
      description="Seguimos ampliando el catálogo de uñas — pregúntanos por WhatsApp."
      whatsappMessage="Hola, quisiera consultar sobre productos de uñas"
      extraLink={{ href: "/productos-para-unas-portoviejo", label: "Ver también: productos para uñas en Portoviejo" }}
    />
  </SectionReveal>
</BaseLayout>
