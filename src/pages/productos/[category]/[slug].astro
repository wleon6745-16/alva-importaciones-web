---
import { getImage } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionReveal from "../../../components/SectionReveal.astro";
import ProductGallery from "../../../components/ProductGallery.astro";
import ProductActionPanel from "../../../components/ProductActionPanel.astro";
import RelatedProducts from "../../../components/RelatedProducts.astro";
import ViewProductTracker from "../../../components/ViewProductTracker.astro";
import { breadcrumbSchema, productSchema } from "../../../lib/structured-data";
import { siteConfig } from "../../../lib/site-config";
import { getAllProducts } from "../../../lib/products";
import type { Product } from "../../../types/product";

// Rutas de esta página dinámica: uñas, capilares y maquillaje. Muebles tiene su propia ruta
// dedicada (src/pages/productos/muebles/[slug].astro, ver SEO-003) y no se genera aquí.
//
// `getStaticPaths` corre en module scope al momento del build y NO puede cerrar sobre un
// `const` declarado en el resto del frontmatter (que corre por render) — solo sobre imports/
// awaits hechos dentro de sí misma. Por eso la lista de categorías manejadas y el filtro de
// productos van inline aquí adentro, y se repiten (con otro nombre) donde hagan falta en el
// resto del archivo. Mismo bug ya encontrado y documentado en SEO-003 (ver
// docs/seo-work/sessions/session-03.md).
export async function getStaticPaths() {
  const handledCategories = ["unas", "capilares", "maquillaje"];
  const products = (await getAllProducts()).filter((p) => handledCategories.includes(p.category));
  return products.map((product) => ({
    params: { category: product.category, slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

const CATEGORY_TITLES: Record<string, string> = {
  unas: "Uñas",
  capilares: "Capilares",
  maquillaje: "Maquillaje",
};

const SUBCATEGORY_TITLES: Record<string, string> = {
  "acrilicos-y-monomeros": "Acrílicos y monómeros",
  esmaltes: "Esmaltes",
  "herramientas-y-equipo": "Herramientas y equipo",
  "tratamientos-y-shampoos": "Tratamientos y shampoos",
  "equipo-capilar": "Equipo capilar",
  "ojos-y-labios": "Ojos y labios",
  rostro: "Rostro",
};

const categoryProducts = (await getAllProducts()).filter((p) => p.category === product.category);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../../assets/products/*/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

function imageFor(category: string, filename: string): ImageMetadata {
  const entry = images[`../../../assets/products/${category}/${filename}`];
  if (!entry) throw new Error(`Imagen no encontrada para: ${category}/${filename}`);
  return entry.default;
}

function priceLabel(p: Product): string {
  if (p.price === undefined) return "Consultar precio";
  const isWhole = Number.isInteger(p.price);
  return `$${p.price.toFixed(isWhole ? 0 : 2)}`;
}

const related = categoryProducts
  .filter((p) => p.subcategory === product.subcategory && p.slug !== product.slug)
  .slice(0, 4);

const pagePath = `/productos/${product.category}/${product.slug}/`;
const pageUrl = new URL(pagePath, siteConfig.url).toString();

const categoryTitle = CATEGORY_TITLES[product.category] ?? product.category;

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Productos", path: "/productos" },
  { name: categoryTitle, path: `/productos/${product.category}` },
  { name: product.name, path: pagePath },
]);

const sameNameCount = categoryProducts.filter((p) => p.name === product.name).length;
const pageTitle = sameNameCount > 1 ? `${product.name} - ${priceLabel(product)}` : product.name;

const description = `${product.name}${product.brand ? ` (${product.brand})` : ""}. ${product.features
  .slice(0, 2)
  .join(", ")}. Precio: ${priceLabel(product)}. Consulta disponibilidad por WhatsApp en Portoviejo, Manabí.`;

const optimizedImage = await getImage({ src: imageFor(product.category, product.image), width: 1200, height: 1200 });
const imageUrl = new URL(optimizedImage.src, siteConfig.url).toString();

const productLd = productSchema(product, pageUrl, imageUrl);
---

<BaseLayout
  title={pageTitle}
  description={description}
  path={pagePath}
  image={optimizedImage.src}
  structuredData={[breadcrumbs, productLd]}
>
  <nav aria-label="Breadcrumb" class="px-6 pt-8 text-sm text-ink-muted">
    <ol class="mx-auto flex max-w-6xl flex-wrap items-center gap-2">
      <li><a href="/" class="hover:text-primary-700">Inicio</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/productos" class="hover:text-primary-700">Productos</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/productos/${product.category}`} class="hover:text-primary-700">{categoryTitle}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink">{product.name}</li>
    </ol>
  </nav>

  <SectionReveal as="section" class="px-6 py-10">
    <div class="mx-auto grid max-w-5xl gap-10 md:grid-cols-2 md:items-start">
      <ProductGallery image={imageFor(product.category, product.image)} alt={product.imageAlt} />
      <ProductActionPanel
        eyebrow={SUBCATEGORY_TITLES[product.subcategory ?? ""] ?? categoryTitle}
        name={product.name}
        priceLabel={priceLabel(product)}
        brand={product.brand}
        code={product.code}
        features={product.features}
        whatsappMessage={`Hola, quisiera consultar sobre: ${product.name}${product.code ? ` (Cód: ${product.code})` : ""} - ${pageUrl}`}
        productId={product.id}
        productName={product.name}
        category={product.category}
      />
    </div>
  </SectionReveal>

  {
    related.length > 0 && (
      <SectionReveal as="section" class="bg-blush-50 px-6 py-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-2xl text-primary-900">También te puede interesar</h2>
          <RelatedProducts
            items={related.map((item) => ({
              href: `/productos/${item.category}/${item.slug}/`,
              image: imageFor(item.category, item.image),
              imageAlt: item.imageAlt,
              name: item.name,
              priceLabel: priceLabel(item),
            }))}
          />
        </div>
      </SectionReveal>
    )
  }

  <ViewProductTracker
    productCode={product.code ?? product.id}
    productName={product.name}
    category={product.category}
    brand={product.brand}
  />
</BaseLayout>
