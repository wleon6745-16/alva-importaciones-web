---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionReveal from "../../components/SectionReveal.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import { breadcrumbSchema } from "../../lib/structured-data";

import img1 from "../../assets/products/maquillaje/makeup-1.png";
import img2 from "../../assets/products/maquillaje/makeup-2.jpg";
import img3 from "../../assets/products/maquillaje/makeup-3.jpg";
import img4 from "../../assets/products/maquillaje/makeup-4.jpg";

const images = [img1, img2, img3, img4];
const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Productos", path: "/productos" },
  { name: "Maquillaje", path: "/productos/maquillaje" },
]);
---

<BaseLayout
  title="Maquillaje"
  description="Maquillaje de marcas como Milani y La Girl USA en Portoviejo. Precio y stock por WhatsApp."
  path="/productos/maquillaje"
  structuredData={[breadcrumbs]}
>
  <section class="hero-glow px-6 py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Categoría</p>
    <h1 class="mt-4 font-display text-4xl text-primary-900">Maquillaje</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
      Maquillaje de marcas reconocidas como Milani y La Girl USA.
    </p>
  </section>

  <SectionReveal as="section" class="px-6 pb-16">
    <div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        images.map((img) => (
          <div class="glass-card overflow-hidden rounded-2xl">
            <Image src={img} alt="Producto de maquillaje" class="aspect-square w-full object-cover" width={400} height={400} />
          </div>
        ))
      }
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="bg-blush-50 px-6 py-16 text-center">
    <h2 class="font-display text-2xl text-primary-900">Precio y disponibilidad exactos por WhatsApp</h2>
    <p class="mt-3 text-ink-muted">Cuéntanos qué producto buscas y te confirmamos al instante.</p>
    <WhatsAppCTA label="Consultar por WhatsApp" class="mt-6" message="Hola, quisiera consultar sobre maquillaje" />
  </SectionReveal>
</BaseLayout>
