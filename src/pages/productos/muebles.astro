---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionReveal from "../../components/SectionReveal.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
import RelatedCategories from "../../components/RelatedCategories.astro";
import { breadcrumbSchema, faqSchema } from "../../lib/structured-data";
import { siteConfig } from "../../lib/site-config";
import { getProductsByCategory } from "../../lib/products";
import type { Product } from "../../types/product";

const products = await getProductsByCategory("muebles");

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/products/muebles/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

function imageFor(filename: string): ImageMetadata {
  const entry = images[`../../assets/products/muebles/${filename}`];
  if (!entry) throw new Error(`Imagen no encontrada para: ${filename}`);
  return entry.default;
}

function priceLabel(product: Product): string {
  if (product.price === undefined) return "Consultar precio";
  const isWhole = Number.isInteger(product.price);
  return `$${product.price.toFixed(isWhole ? 0 : 2)}`;
}

const SUBCATEGORY_TITLES: Record<string, string> = {
  camillas: "Camillas",
  "sillones-y-sillas-de-peluqueria-barberia": "Sillones y sillas de peluquería / barbería",
  "butacas-y-sillas": "Butacas y sillas",
  "mesas-de-trabajo": "Mesas de trabajo",
  "equipo-y-accesorios-de-salon": "Equipo y accesorios de salón",
};

const SUBCATEGORY_ORDER = Object.keys(SUBCATEGORY_TITLES);

const LANDING_LINKS: Record<string, { href: string; label: string }> = {
  camillas: { href: "/camillas-esteticas-portoviejo", label: "Ver camillas estéticas en Portoviejo →" },
  "sillones-y-sillas-de-peluqueria-barberia": {
    href: "/sillas-de-barberia-portoviejo",
    label: "Ver sillas de barbería en Portoviejo →",
  },
  "equipo-y-accesorios-de-salon": {
    href: "/equipamiento-para-peluquerias-manabi",
    label: "Ver equipamiento para peluquerías en Manabí →",
  },
};

const sections = SUBCATEGORY_ORDER.map((subcategory) => ({
  subcategory,
  title: SUBCATEGORY_TITLES[subcategory],
  items: products.filter((p) => p.subcategory === subcategory),
})).filter((section) => section.items.length > 0);

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Productos", path: "/productos" },
  { name: "Muebles", path: "/productos/muebles" },
]);

const faqs = [
  {
    question: "¿Qué tipo de muebles tienen disponibles para salones de belleza?",
    answer:
      "Camillas, sillones de peluquería y barbería, butacas y sillas para manicura/pedicura, mesas de trabajo y equipo como lavacabezas y carritos auxiliares.",
  },
  {
    question: "¿Cómo consulto el precio y la disponibilidad de un mueble?",
    answer:
      "Cada producto tiene un botón para consultar por WhatsApp con el nombre y código del mueble ya incluido, así te respondemos más rápido.",
  },
  {
    question: "¿Puedo ver los muebles antes de comprar?",
    answer:
      "Sí, puedes visitarnos en nuestros locales de Matriz o Sucursal en Portoviejo. Encuentra las direcciones y el horario en la página de Contacto.",
  },
  {
    question: "¿Los muebles publicados aquí son todo lo que tienen disponible?",
    answer:
      "Publicamos el catálogo que tenemos identificado y fotografiado; si no encuentras lo que buscas, escríbenos por WhatsApp y seguimos ampliando el catálogo.",
  },
];
const faqLd = faqSchema(faqs);
---

<BaseLayout
  title="Muebles para Salón de Belleza"
  description="Camillas, sillones de peluquería, butacas y mesas de trabajo para salones de belleza en Portoviejo. Precios y disponibilidad por WhatsApp."
  path="/productos/muebles"
  structuredData={[breadcrumbs, faqLd]}
>
  <section class="hero-glow px-6 py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Destacado</p>
    <h1 class="mt-4 font-display text-4xl text-primary-900 sm:text-5xl">
      Muebles para tu salón de belleza
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
      Camillas, sillones de peluquería, butacas y mesas de trabajo, listos para equipar o
      renovar tu espacio en Portoviejo.
    </p>
    <WhatsAppCTA label="Consultar por WhatsApp" pulse class="mt-8" message="Hola, quisiera consultar sobre muebles para mi salón" source="category" pageType="category" category="muebles" ctaLocation="hero" />
  </section>

  <nav aria-label="Categorías de muebles" class="px-6 pb-4">
    <ul class="mx-auto flex max-w-6xl flex-wrap justify-center gap-3">
      {
        sections.map((section) => (
          <li>
            <a
              href={`#${section.subcategory}`}
              class="inline-block rounded-full border border-primary-200 px-4 py-2 text-sm font-medium text-primary-800 transition-colors hover:border-primary-800 hover:bg-primary-800 hover:text-white"
            >
              {section.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    sections.map((section) => (
      <SectionReveal as="section" id={section.subcategory} class="scroll-mt-24 px-6 py-16">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-3xl text-primary-900">{section.title}</h2>
          {LANDING_LINKS[section.subcategory] && (
            <a
              href={LANDING_LINKS[section.subcategory].href}
              class="mt-2 inline-block text-sm font-semibold text-primary-700 hover:underline"
            >
              {LANDING_LINKS[section.subcategory].label}
            </a>
          )}
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {section.items.map((item) => (
              <div class="glass-card flex flex-col overflow-hidden rounded-2xl shadow-md">
                <a href={`/productos/muebles/${item.slug}/`} class="block">
                  <div class="aspect-square overflow-hidden bg-white">
                    <Image
                      src={imageFor(item.image)}
                      alt={item.imageAlt}
                      width={500}
                      height={500}
                      class="h-full w-full object-contain"
                    />
                  </div>
                </a>
                <div class="flex flex-1 flex-col gap-2 p-5">
                  <h3 class="font-display text-lg text-primary-800">
                    <a href={`/productos/muebles/${item.slug}/`} class="hover:text-primary-600">
                      {item.name}
                    </a>
                  </h3>
                  <p class="text-xl font-semibold text-ink">{priceLabel(item)}</p>
                  {item.features.length > 0 && (
                    <ul class="mt-1 space-y-1 text-sm text-ink-muted">
                      {item.features.map((f) => (
                        <li>• {f}</li>
                      ))}
                    </ul>
                  )}
                  {item.code && <p class="text-xs text-ink-muted">Cód: {item.code}</p>}
                  <WhatsAppCTA
                    label="Consultar"
                    class="mt-auto !px-4 !py-2 text-sm"
                    message={`Hola, quisiera consultar sobre: ${item.name} - ${new URL(`/productos/muebles/${item.slug}/`, siteConfig.url).toString()}`}
                    productId={item.id}
                    productName={item.name}
                    category={item.category}
                    source="product"
                    pageType="category"
                    ctaLocation="grid"
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      </SectionReveal>
    ))
  }

  <SectionReveal as="section" class="bg-blush-50 px-6 py-16 text-center">
    <h2 class="font-display text-2xl text-primary-900">¿No encuentras lo que buscas?</h2>
    <p class="mt-3 text-ink-muted">Pregúntanos, seguimos ampliando el catálogo de muebles.</p>
    <WhatsAppCTA label="Consultar por WhatsApp" class="mt-6" source="category" pageType="category" category="muebles" ctaLocation="bottom" />
  </SectionReveal>

  <SectionReveal as="section" class="px-6 py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display text-2xl text-primary-900">Preguntas frecuentes</h2>
      <dl class="mt-8 space-y-6">
        {
          faqs.map((faq) => (
            <div>
              <dt class="font-display text-lg text-primary-800">{faq.question}</dt>
              <dd class="mt-2 text-ink-muted">{faq.answer}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="bg-blush-50 px-6 py-16 text-center">
    <RelatedCategories current="muebles" />
  </SectionReveal>
</BaseLayout>
