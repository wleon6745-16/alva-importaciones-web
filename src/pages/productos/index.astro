---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionReveal from "../../components/SectionReveal.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import WhatsAppCTA from "../../components/WhatsAppCTA.astro";
// nails-2.jpg / makeup-3.jpg: fotos de estudio limpias (fondo blanco), no las
// fotos individuales tomadas en tienda (estantes/reflejos de fondo). Mismos
// assets que usa la home para estas categorías.
import nailsImage from "../../assets/products/unas/nails-2.jpg";
import hairImage from "../../assets/products/capilares/keratina-ambroisie-250ml-rene-chardon.jpg";
import makeupImage from "../../assets/products/maquillaje/makeup-3.jpg";
import mueblesImage from "../../assets/products/muebles/silla-barberia-st2200.jpg";

const categories = [
  {
    title: "Muebles para salón",
    description: "Camillas, sillones de peluquería, butacas y mesas de trabajo.",
    image: mueblesImage,
    href: "/productos/muebles",
  },
  {
    title: "Uñas / Nailart",
    description: "Acrílicos, geles, esmaltes y todo lo necesario para nail art profesional.",
    image: nailsImage,
    href: "/productos/unas",
  },
  {
    title: "Capilares",
    description: "Tratamientos y productos capilares de marcas reconocidas.",
    image: hairImage,
    href: "/productos/capilares",
  },
  {
    title: "Maquillaje",
    description: "Maquillaje de marcas como Milani y La Girl USA.",
    image: makeupImage,
    href: "/productos/maquillaje",
  },
];

// Categorías reales adicionales (sin catálogo curado/foto editorial todavía
// -- ver src/pages/productos/[category].astro). Se listan aparte, sin foto
// inventada (ver punto 18 del pedido de Fase 2: nunca fabricar imágenes).
const CURATED_SLUGS = new Set(categories.map((c) => c.href.split("/").pop()));
const storefrontEntries = await getCollection("storefrontCatalog");
const moreCategories = storefrontEntries
  .filter((entry) => !CURATED_SLUGS.has(entry.data.categorySlug))
  .sort((a, b) => a.data.categoryLabel.localeCompare(b.data.categoryLabel, "es"))
  .map((entry) => ({
    label: entry.data.categoryLabel,
    href: `/productos/${entry.data.categorySlug}`,
    count: entry.data.productCount,
  }));
---

<BaseLayout
  title="Productos"
  description="Insumos de uñas, capilares y maquillaje disponibles en Alva Importaciones, Portoviejo."
  path="/productos"
>
  <section class="hero-glow px-6 py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Catálogo</p>
    <h1 class="mt-4 font-display text-4xl text-primary-900">Nuestros productos</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
      Estas son nuestras categorías. El precio y la disponibilidad exacta de cada producto los
      confirmamos al instante por WhatsApp.
    </p>
  </section>

  <SectionReveal as="section" class="px-6 pb-20">
    <h2 class="sr-only">Categorías de productos</h2>
    <div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => <CategoryCard {...c} />)}
    </div>
  </SectionReveal>

  {
    moreCategories.length > 0 && (
      <SectionReveal as="section" class="px-6 pb-20">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-display text-2xl text-primary-900">Más categorías</h2>
          <p class="mt-2 text-ink-muted">Catálogo real, en construcción editorial — precio público disponible.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            {moreCategories.map((c) => (
              <a
                href={c.href}
                class="inline-flex items-center gap-2 rounded-full border-2 border-primary-800 px-5 py-3 text-sm font-semibold text-primary-800 transition-colors hover:bg-primary-800 hover:text-white"
              >
                {c.label}
                <span class="text-xs font-normal opacity-70">({c.count.toLocaleString("es-EC")})</span>
              </a>
            ))}
          </div>
        </div>
      </SectionReveal>
    )
  }

  <SectionReveal as="section" class="bg-blush-50 px-6 py-16 text-center">
    <h2 class="font-display text-2xl text-primary-900">¿Buscas algo puntual?</h2>
    <p class="mt-3 text-ink-muted">Pregúntanos directamente, tenemos precio y stock al instante.</p>
    <WhatsAppCTA label="Consultar por WhatsApp" class="mt-6" source="catalog" pageType="catalog" />
  </SectionReveal>
</BaseLayout>
