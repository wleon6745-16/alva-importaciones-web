---
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
---

<BaseLayout title="Página no encontrada" path="/404" noindex>
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-6 text-center">
    <p class="font-display text-6xl text-primary-800">404</p>
    <h1 class="mt-4 font-display text-2xl text-primary-900">Esta página no existe</h1>
    <p class="mt-3 text-ink-muted">Puede que el enlace esté roto o la página se haya movido.</p>
    <div class="mt-8 flex gap-4">
      <a href="/" class="rounded-full border-2 border-primary-800 px-6 py-3 font-semibold text-primary-800 hover:bg-primary-800 hover:text-white">
        Ir al inicio
      </a>
      <WhatsAppCTA label="Escríbenos" />
    </div>
  </section>
</BaseLayout>
