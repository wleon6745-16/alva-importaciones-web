---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionReveal from "../components/SectionReveal.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import LocationsMap from "../components/LocationsMap.astro";
import { localBusinessSchemas, breadcrumbSchema } from "../lib/structured-data";
import { siteConfig } from "../lib/site-config";
import { getOmviqaEditorial, type OmviqaPage } from "../lib/omviqa-editorial";

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Contacto", path: "/contacto" },
]);
const pageCollection = await getOmviqaEditorial<OmviqaPage>("page");
const pageItem = pageCollection?.items.find((item) => item.contentKey === "contacto" || item.payload.slug === "contacto") ?? null;
const page = pageItem?.payload ?? null;
---

<BaseLayout
  title={page?.seo?.title || page?.title || "Contacto"}
  description={page?.seo?.description || "Horario, ubicación y WhatsApp de Alva Importaciones en Portoviejo, Manabí."}
  path="/contacto"
  structuredData={[...localBusinessSchemas(), breadcrumbs]}
>
  <section class="hero-glow px-6 py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">{page?.eyebrow || "Contacto"}</p>
    <h1 class="mt-4 font-display text-4xl text-primary-900">{page?.title || "Visítanos o escríbenos"}</h1>
    {page?.body && <p class="mx-auto mt-4 max-w-2xl text-lg text-ink-muted">{page.body}</p>}
    <WhatsAppCTA label={page?.ctaLabel || "Chatea por WhatsApp"} pulse class="mt-8" source="contact" pageType="contact" ctaLocation="hero" />
  </section>

  <SectionReveal as="section" class="px-6 pb-16">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-center font-display text-2xl text-primary-900">Nuestros locales</h2>
      <div class="mt-8">
        <LocationsMap />
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="bg-blush-50 px-6 py-16">
    <div class="mx-auto max-w-md text-center">
      <h2 class="font-display text-2xl text-primary-900">Horario de atención</h2>
      <ul class="mt-6 space-y-2 text-ink-muted">
        {siteConfig.hours.map((h) => <li>{h.days}: {h.time}</li>)}
      </ul>
    </div>
  </SectionReveal>
</BaseLayout>
