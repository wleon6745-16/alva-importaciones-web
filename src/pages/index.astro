---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionReveal from "../components/SectionReveal.astro";
import CategoryCard from "../components/CategoryCard.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import ChatDemo from "../components/ChatDemo.tsx";
import PromoShowcase from "../components/PromoShowcase.astro";
import TrustSection from "../components/TrustSection.astro";
import { siteConfig } from "../lib/site-config";

import heroImage from "../assets/products/muebles/camilla-3-niveles.jpg";
import nailsImage from "../assets/products/unas/monomero-master-nails-16oz.jpg";
import hairImage from "../assets/products/capilares/keratina-ambroisie-250ml-rene-chardon.jpg";
import makeupImage from "../assets/products/maquillaje/paleta-sombras-satine.jpg";
import mueblesImage from "../assets/products/muebles/silla-barberia-st2200.jpg";
import sillonDestacado from "../assets/products/muebles/sillon-peluqueria-1.jpg";
import camillaDestacada from "../assets/products/muebles/camilla-3-niveles.jpg";
import mesaDestacada from "../assets/products/muebles/mesa-silla-concha-manicura.jpg";

const categories = [
  {
    title: "Muebles para salón",
    description: "Camillas, sillones de peluquería, butacas y mesas de trabajo.",
    image: mueblesImage,
    href: "/productos/muebles",
  },
  {
    title: "Uñas / Nailart",
    description: "Acrílicos, geles, esmaltes y todo lo necesario para nail art profesional.",
    image: nailsImage,
    href: "/productos/unas",
  },
  {
    title: "Capilares",
    description: "Tratamientos y productos capilares de marcas reconocidas.",
    image: hairImage,
    href: "/productos/capilares",
  },
  {
    title: "Maquillaje",
    description: "Maquillaje de marcas como Milani y La Girl USA.",
    image: makeupImage,
    href: "/productos/maquillaje",
  },
];

const mueblesDestacados = [
  { name: "Sillón de peluquería ST-2202", price: "$345", image: sillonDestacado, slug: "sillon-de-peluqueria-st-2202" },
  { name: "Camilla multiuso 3 niveles", price: "$208", image: camillaDestacada, slug: "camilla-multiuso-3-niveles" },
  { name: "Set mesa + silla concha", price: "$350", image: mesaDestacada, slug: "set-mesa-silla-concha-para-manicura" },
];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description} path="/">
  <section class="relative overflow-hidden bg-primary-900">
    <div
      class="absolute inset-0 opacity-40"
      style="background-image: radial-gradient(circle at 20% 20%, rgba(227,28,77,0.35), transparent 55%), radial-gradient(circle at 80% 80%, rgba(227,28,77,0.25), transparent 50%);"
    >
    </div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 py-20 sm:py-28 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-blush-100">
          {siteConfig.tagline}
        </p>
        <h1 class="mt-4 font-display text-4xl leading-tight text-white sm:text-5xl lg:text-6xl">
          Equipa tu salón con muebles y marcas profesionales
        </h1>
        <p class="mt-6 max-w-lg text-lg text-white/80">
          Camillas, sillones de peluquería, butacas y mesas de trabajo — además de insumos de
          uñas, capilares y maquillaje. Todo en Portoviejo, con precio y disponibilidad al
          instante por WhatsApp.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <WhatsAppCTA label="Chatea por WhatsApp" pulse />
          <a
            href="/productos/muebles"
            class="inline-flex items-center gap-2 rounded-full border-2 border-white px-6 py-3 font-semibold text-white transition-transform hover:scale-105 hover:bg-white hover:text-primary-900"
          >
            Ver catálogo de muebles
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-sm lg:max-w-md">
        <div class="absolute -inset-4 rounded-[2rem] bg-primary-700/30 blur-2xl"></div>
        <Image
          src={heroImage}
          alt="Camilla profesional Alva Importaciones"
          class="relative w-full rounded-3xl bg-white object-cover shadow-2xl"
          width={708}
          height={800}
          densities={[1, 1.5, 2]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <SectionReveal as="section" class="px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <p class="text-center text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">
        Lo más nuevo
      </p>
      <h2 class="mt-2 text-center font-display text-3xl text-primary-900">
        Muebles para tu salón
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-ink-muted">
        Camillas, sillones y estaciones de trabajo listos para tu negocio.
      </p>
      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        {
          mueblesDestacados.map((m) => (
            <div class="glass-card group overflow-hidden rounded-2xl shadow-md transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl">
              <a href={`/productos/muebles/${m.slug}/`} class="block">
                <div class="aspect-square overflow-hidden bg-white">
                  <Image
                    src={m.image}
                    alt={m.name}
                    width={500}
                    height={500}
                    class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
              </a>
              <div class="flex flex-col gap-2 p-5">
                <a href={`/productos/muebles/${m.slug}/`} class="font-display text-lg text-primary-800 hover:text-primary-600">
                  {m.name}
                </a>
                <p class="text-lg font-semibold text-ink">{m.price}</p>
                <WhatsAppCTA
                  label="Consultar"
                  class="mt-1 w-fit !px-4 !py-2 text-sm"
                  message={`Hola, quisiera consultar sobre: ${m.name}`}
                />
              </div>
            </div>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <a
          href="/productos/muebles"
          class="inline-flex items-center gap-2 rounded-full bg-primary-800 px-6 py-3 font-semibold text-white transition-transform hover:scale-105 hover:bg-primary-700"
        >
          Ver todos los muebles →
        </a>
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="bg-blush-50 px-6 py-20">
    <PromoShowcase />
  </SectionReveal>

  <SectionReveal as="section" class="px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center font-display text-3xl text-primary-900">Nuestras categorías</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-ink-muted">
        Explora lo que tenemos disponible. Precio y stock exactos siempre por WhatsApp.
      </p>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {categories.map((c) => <CategoryCard {...c} />)}
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" id="asistente-ia" class="bg-blush-50 px-6 py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">
          Asistente por WhatsApp
        </p>
        <h2 class="mt-4 font-display text-3xl text-primary-900">
          Respuestas al instante, con precio y stock reales
        </h2>
        <p class="mt-6 text-ink-muted">
          Creamos un asistente de inteligencia artificial que responde tus consultas de
          WhatsApp en segundos: precios actualizados, disponibilidad real y sugerencias si
          un producto se agotó. Cuando hace falta, una asesora toma la conversación.
        </p>
        <WhatsAppCTA label="Pruébalo por WhatsApp" class="mt-8" />
      </div>
      <ChatDemo client:visible />
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="px-6 py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <div class="glass-card rounded-3xl p-8">
          <p class="font-display text-2xl text-primary-800">Curso Profesional de Uñas Acrílicas</p>
          <p class="mt-4 text-ink-muted">
            6 meses de formación profesional. $60 al mes (o 2 pagos de $30), con matrícula
            de $10 para separar tu cupo.
          </p>
          <a
            href="/cursos"
            class="mt-6 inline-block font-semibold text-primary-700 hover:underline"
          >
            Conoce el curso →
          </a>
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <h2 class="font-display text-3xl text-primary-900">¿Quieres vivir de las uñas?</h2>
        <p class="mt-6 text-ink-muted">
          Además de vender los insumos, formamos a la próxima generación de nail artists en
          Portoviejo con nuestro curso profesional.
        </p>
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="bg-blush-50 px-6 py-20">
    <TrustSection />
  </SectionReveal>

  <SectionReveal as="section" class="px-6 pb-24">
    <div class="mx-auto max-w-3xl rounded-3xl bg-primary-800 px-8 py-16 text-center text-white">
      <h2 class="font-display text-3xl">¿Lista para tu próximo pedido?</h2>
      <p class="mt-4 text-blush-100/90">
        Escríbenos por WhatsApp, visita uno de nuestros locales o revisa el catálogo completo —
        te ayudamos al instante.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <WhatsAppCTA label="Chatea por WhatsApp" variant="outline" class="!border-white !text-white hover:!bg-white hover:!text-primary-800" />
        <a
          href="/locales"
          class="inline-flex items-center gap-2 rounded-full border-2 border-white px-6 py-3 font-semibold text-white transition-transform hover:scale-105 hover:bg-white hover:text-primary-800"
        >
          Visitar un local
        </a>
      </div>
    </div>
  </SectionReveal>
</BaseLayout>
