---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionReveal from "../components/SectionReveal.astro";
import CategoryCard from "../components/CategoryCard.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import ChatDemo from "../components/ChatDemo.tsx";
import TestimonialCarousel from "../components/TestimonialCarousel.tsx";
import { siteConfig } from "../lib/site-config";

import heroImage from "../assets/products/hero/hero-nails.jpg";
import nailsImage from "../assets/products/unas/nails-1.jpg";
import hairImage from "../assets/products/capilares/hair-3.png";
import makeupImage from "../assets/products/maquillaje/makeup-3.jpg";

const categories = [
  {
    title: "Uñas / Nailart",
    description: "Acrílicos, geles, esmaltes y todo lo necesario para nail art profesional.",
    image: nailsImage,
    href: "/productos/unas",
  },
  {
    title: "Capilares",
    description: "Tratamientos y productos capilares de marcas reconocidas.",
    image: hairImage,
    href: "/productos/capilares",
  },
  {
    title: "Maquillaje",
    description: "Maquillaje de marcas como Milani y La Girl USA.",
    image: makeupImage,
    href: "/productos/maquillaje",
  },
];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description} path="/">
  <section class="hero-glow relative overflow-hidden px-6 py-20 sm:py-28">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">
          {siteConfig.tagline}
        </p>
        <h1 class="mt-4 font-display text-4xl leading-tight text-primary-900 sm:text-5xl">
          Todo lo que necesitas para tu negocio de belleza, en un solo lugar
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink-muted">
          Importamos y distribuimos insumos de uñas, capilares y maquillaje en Portoviejo.
          Consulta precios y disponibilidad al instante, sin salir de WhatsApp.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <WhatsAppCTA label="Chatea por WhatsApp" pulse />
          <a
            href="/productos"
            class="inline-flex items-center gap-2 rounded-full border-2 border-primary-800 px-6 py-3 font-semibold text-primary-800 transition-transform hover:scale-105 hover:bg-primary-800 hover:text-white"
          >
            Ver productos
          </a>
        </div>
      </div>

      <div class="relative">
        <Image
          src={heroImage}
          alt="Productos de uñas Alva Importaciones"
          class="mx-auto w-full max-w-md rounded-3xl object-cover shadow-2xl"
          width={640}
          height={800}
        />
      </div>
    </div>
  </section>

  <SectionReveal as="section" class="px-6 py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center font-display text-3xl text-primary-900">Nuestras categorías</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-ink-muted">
        Explora lo que tenemos disponible. Precio y stock exactos siempre por WhatsApp.
      </p>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c) => <CategoryCard {...c} />)}
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" id="asistente-ia" class="bg-blush-50 px-6 py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">
          Asistente por WhatsApp
        </p>
        <h2 class="mt-4 font-display text-3xl text-primary-900">
          Respuestas al instante, con precio y stock reales
        </h2>
        <p class="mt-6 text-ink-muted">
          Creamos un asistente de inteligencia artificial que responde tus consultas de
          WhatsApp en segundos: precios actualizados, disponibilidad real y sugerencias si
          un producto se agotó. Cuando hace falta, una asesora toma la conversación.
        </p>
        <WhatsAppCTA label="Pruébalo por WhatsApp" class="mt-8" />
      </div>
      <ChatDemo client:visible />
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="px-6 py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <div class="glass-card rounded-3xl p-8">
          <p class="font-display text-2xl text-primary-800">Curso Profesional de Uñas Acrílicas</p>
          <p class="mt-4 text-ink-muted">
            6 meses de formación profesional. $60 al mes (o 2 pagos de $30), con matrícula
            de $10 para separar tu cupo.
          </p>
          <a
            href="/cursos"
            class="mt-6 inline-block font-semibold text-primary-700 hover:underline"
          >
            Conoce el curso →
          </a>
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <h2 class="font-display text-3xl text-primary-900">¿Quieres vivir de las uñas?</h2>
        <p class="mt-6 text-ink-muted">
          Además de vender los insumos, formamos a la próxima generación de nail artists en
          Portoviejo con nuestro curso profesional.
        </p>
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="bg-blush-50 px-6 py-16">
    <div class="mx-auto max-w-6xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">
        Marcas que manejamos
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-x-8 gap-y-4">
        {
          siteConfig.brands.map((brand) => (
            <span class="font-display text-lg text-ink-muted/80">{brand}</span>
          ))
        }
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="px-6 py-20">
    <TestimonialCarousel client:visible />
  </SectionReveal>

  <SectionReveal as="section" class="px-6 pb-24">
    <div class="mx-auto max-w-3xl rounded-3xl bg-primary-800 px-8 py-16 text-center text-white">
      <h2 class="font-display text-3xl">¿Lista para tu próximo pedido?</h2>
      <p class="mt-4 text-blush-100/90">
        Escríbenos por WhatsApp y te ayudamos al instante.
      </p>
      <WhatsAppCTA label="Chatea por WhatsApp" variant="outline" class="mt-8 !border-white !text-white hover:!bg-white hover:!text-primary-800" />
    </div>
  </SectionReveal>
</BaseLayout>
