---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionReveal from "../components/SectionReveal.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import OmviqaCoursePage from "../components/OmviqaCoursePage.astro";
import { getOmviqaEditorial, type OmviqaCourse } from "../lib/omviqa-editorial";
import { courseSchema, breadcrumbSchema } from "../lib/structured-data";
import cursoImage from "../assets/products/hero/cat-curso.jpeg";

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Cursos", path: "/cursos" },
]);

// Un solo curso activo hoy — se toma el primero de la colección editable desde /admin.
const [curso] = await getCollection("cursos");
const omviqaCourses = await getOmviqaEditorial<OmviqaCourse>("course");
const { title, description, intro, highlights, ctaLabel, ctaMessage } = curso.data;

// Valor de un highlight por label -- para no repetir "$60 al mes" a mano en
// el FAQ/badge cuando ya vive en highlights (misma fuente que la ficha).
function highlight(label: string): string | null {
  return highlights.find((h) => h.label === label)?.value ?? null;
}
const inversion = highlight("Inversión");
const matricula = highlight("Matrícula");
const duracion = highlight("Duración");
---

<BaseLayout
  title={omviqaCourses?.items[0]?.payload.seo?.title || omviqaCourses?.items[0]?.payload.title || title}
  description={omviqaCourses?.items[0]?.payload.seo?.description || omviqaCourses?.items[0]?.payload.description || description}
  path="/cursos"
  structuredData={[courseSchema(title, description), breadcrumbs]}
>
  {omviqaCourses ? (
    <OmviqaCoursePage collection={omviqaCourses} />
  ) : (
  <>
    <section class="hero-glow px-6 py-16">
    <div class="mx-auto grid max-w-5xl items-center gap-10 lg:grid-cols-2">
      <div class="text-center lg:text-left">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Formación</p>
        <h1 class="text-display-lg mt-4 text-primary-900">
          {title}
        </h1>
        <p class="mt-6 text-lg text-ink-muted">
          {intro}
        </p>
        {duracion && (
          <div class="mt-6 flex flex-wrap justify-center gap-3 lg:justify-start">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white/70 px-4 py-2 text-sm font-semibold text-primary-800 shadow-sm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
              {duracion}
            </span>
            {inversion && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/70 px-4 py-2 text-sm font-semibold text-primary-800 shadow-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v10M9.5 9.5h4a1.75 1.75 0 0 1 0 3.5h-3a1.75 1.75 0 0 0 0 3.5h4" /></svg>
                {inversion}
              </span>
            )}
          </div>
        )}
      </div>
      <div class="relative overflow-hidden rounded-3xl shadow-xl">
        <Image
          src={cursoImage}
          alt={`Clase práctica del ${title} — Alva Importaciones`}
          width={800}
          height={500}
          class="aspect-[16/10] h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        {inversion && (
          <div class="absolute bottom-4 right-4 rounded-2xl bg-white px-4 py-3 text-center shadow-lg">
            <p class="text-[0.65rem] font-semibold uppercase tracking-wide text-primary-700">Inversión</p>
            <p class="font-display text-lg text-ink">{inversion}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <SectionReveal as="section" class="section-y px-6">
    <div class="mx-auto max-w-4xl">
      <p class="text-center text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">¿Por qué con Alva?</p>
      <h2 class="mt-2 text-center font-display text-3xl text-primary-900">Formación respaldada por un negocio real</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <div class="glass-card rounded-2xl p-6">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-800/10 text-primary-800" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V8l9-5 9 5v13" /><path d="M9 21v-7h6v7" /></svg>
          </span>
          <p class="mt-4 font-display text-lg text-primary-900">Un negocio real en Portoviejo</p>
          <p class="mt-2 text-sm text-ink-muted">No es un curso online anónimo: dictado por Alva Importaciones, con locales físicos en la ciudad.</p>
        </div>
        <div class="glass-card rounded-2xl p-6">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-800/10 text-primary-800" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 7.3 12 12l-8.5-4.7M12 12v9M3.5 7.3v9.4L12 21l8.5-4.3V7.3L12 3z" /></svg>
          </span>
          <p class="mt-4 font-display text-lg text-primary-900">Practicas con insumos profesionales</p>
          <p class="mt-2 text-sm text-ink-muted">Las mismas marcas que vendemos en el catálogo, de primera mano durante tu formación.</p>
        </div>
        <div class="glass-card rounded-2xl p-6">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-800/10 text-primary-800" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-12.3 7.5L3 20.5l1.6-5.5A8.5 8.5 0 1 1 21 11.5Z" /></svg>
          </span>
          <p class="mt-4 font-display text-lg text-primary-900">Acompañamiento directo</p>
          <p class="mt-2 text-sm text-ink-muted">Una asesora responde tus dudas por WhatsApp durante todo el proceso de inscripción.</p>
        </div>
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="section-y bg-blush-50 px-6">
    <div class="mx-auto max-w-3xl">
      <p class="text-center text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Tu inversión</p>
      <h2 class="mt-2 text-center font-display text-3xl text-primary-900">Lo que incluye el programa</h2>
      <div class="mt-10 overflow-hidden rounded-2xl border border-blush-100 bg-white shadow-sm">
        <div class="grid grid-cols-1 gap-px bg-blush-100 sm:grid-cols-2">
          {
            highlights.map((h) => (
              <div class="bg-white p-6">
                <p class="text-sm font-semibold uppercase tracking-wide text-primary-700">
                  {h.label}
                </p>
                <p class="mt-2 font-display text-xl text-ink">{h.value}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="mt-8 text-center">
        <WhatsAppCTA
          label={ctaLabel}
          pulse
          message={ctaMessage}
          source="course"
          pageType="course"
          ctaLocation="pricing_card"
          extraTrackEvents={["click_course_contact"]}
        />
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="section-y px-6">
    <div class="mx-auto max-w-4xl">
      <p class="text-center text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Proceso</p>
      <h2 class="mt-2 text-center font-display text-3xl text-primary-900">Cómo reservar tu cupo</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-3">
        <div class="text-center">
          <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary-800 font-display text-lg text-white">1</span>
          <p class="mt-4 font-display text-lg text-primary-900">Escríbenos por WhatsApp</p>
          <p class="mt-2 text-sm text-ink-muted">Cuéntanos que quieres inscribirte al curso de uñas acrílicas.</p>
        </div>
        <div class="text-center">
          <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary-800 font-display text-lg text-white">2</span>
          <p class="mt-4 font-display text-lg text-primary-900">Confirmamos el horario</p>
          <p class="mt-2 text-sm text-ink-muted">Una asesora te dice qué horario está abierto según los cupos disponibles.</p>
        </div>
        <div class="text-center">
          <span class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary-800 font-display text-lg text-white">3</span>
          <p class="mt-4 font-display text-lg text-primary-900">Separas tu cupo</p>
          <p class="mt-2 text-sm text-ink-muted">{matricula ? `Con la matrícula (${matricula}) tu lugar queda reservado.` : "Con la matrícula tu lugar queda reservado."}</p>
        </div>
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="section-y bg-blush-50 px-6">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center font-display text-2xl text-primary-900">Preguntas frecuentes</h2>
      <dl class="mt-8 space-y-6">
        <div>
          <dt class="font-display text-lg text-primary-800">¿Cómo se paga el curso?</dt>
          <dd class="mt-2 text-ink-muted">
            {inversion ? `${inversion}` : "Consulta el plan de pago"}{matricula ? `, más una matrícula de ${matricula} para separar tu cupo.` : "."}
          </dd>
        </div>
        <div>
          <dt class="font-display text-lg text-primary-800">¿Cuándo empieza el próximo grupo?</dt>
          <dd class="mt-2 text-ink-muted">Los horarios se abren según la disponibilidad de cupos — escríbenos por WhatsApp y una asesora te confirma la fecha más próxima.</dd>
        </div>
        <div>
          <dt class="font-display text-lg text-primary-800">¿Dónde son las clases?</dt>
          <dd class="mt-2 text-ink-muted">En Portoviejo. Al reservar tu cupo te confirmamos la sede y el horario exactos.</dd>
        </div>
      </dl>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="section-y px-6 text-center">
    <h2 class="font-display text-2xl text-primary-900">¿Lista para reservar tu cupo?</h2>
    <p class="mx-auto mt-3 max-w-xl text-ink-muted">
      Una asesora te confirma qué horario está abierto actualmente y cómo separar tu lugar
      con la matrícula.
    </p>
    <WhatsAppCTA
      label={ctaLabel}
      class="mt-6"
      message={ctaMessage}
      source="course"
      pageType="course"
      ctaLocation="bottom"
      extraTrackEvents={["click_course_contact"]}
    />
    <a href="/cursos-de-unas-portoviejo" class="mt-4 block text-sm font-semibold text-primary-700 hover:underline">
      Ver también: cursos de uñas en Portoviejo →
    </a>
    </SectionReveal>
  </>
  )}
</BaseLayout>
