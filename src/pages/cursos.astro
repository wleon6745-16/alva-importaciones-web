---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionReveal from "../components/SectionReveal.astro";
import WhatsAppCTA from "../components/WhatsAppCTA.astro";
import { courseSchema, breadcrumbSchema } from "../lib/structured-data";

const breadcrumbs = breadcrumbSchema([
  { name: "Inicio", path: "/" },
  { name: "Cursos", path: "/cursos" },
]);

// Un solo curso activo hoy — se toma el primero de la colección editable desde /admin.
const [curso] = await getCollection("cursos");
const { title, description, intro, highlights, ctaLabel, ctaMessage } = curso.data;
---

<BaseLayout
  title={title}
  description={description}
  path="/cursos"
  structuredData={[courseSchema(title, description), breadcrumbs]}
>
  <section class="hero-glow px-6 py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary-700">Formación</p>
    <h1 class="mt-4 font-display text-4xl text-primary-900">
      {title}
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-ink-muted">
      {intro}
    </p>
  </section>

  <SectionReveal as="section" class="px-6 pb-14">
    {/* Un solo panel con divisores sutiles (en vez de 4 tarjetas flotantes
       separadas) -- lee como una sola ficha del programa, no como bloques
       sueltos con aire de más entre ellos. */}
    <div class="mx-auto max-w-4xl overflow-hidden rounded-2xl border border-blush-100 bg-blush-100 shadow-sm">
      <div class="grid grid-cols-1 gap-px sm:grid-cols-2">
        {
          highlights.map((h) => (
            <div class="bg-white p-6">
              <p class="text-sm font-semibold uppercase tracking-wide text-primary-700">
                {h.label}
              </p>
              <p class="mt-2 font-display text-xl text-ink">{h.value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </SectionReveal>

  <SectionReveal as="section" class="bg-blush-50 px-6 py-14 text-center">
    <h2 class="font-display text-2xl text-primary-900">¿Lista para reservar tu cupo?</h2>
    <p class="mx-auto mt-3 max-w-xl text-ink-muted">
      Una asesora te confirma qué horario está abierto actualmente y cómo separar tu lugar
      con la matrícula.
    </p>
    <WhatsAppCTA
      label={ctaLabel}
      class="mt-6"
      message={ctaMessage}
      source="course"
      pageType="course"
      ctaLocation="bottom"
      extraTrackEvents={["click_course_contact"]}
    />
    <a href="/cursos-de-unas-portoviejo" class="mt-4 block text-sm font-semibold text-primary-700 hover:underline">
      Ver también: cursos de uñas en Portoviejo →
    </a>
  </SectionReveal>
</BaseLayout>
