---
import SectionReveal from "../../components/SectionReveal.astro";
import GuideLayout from "../../components/GuideLayout.astro";

const steps = [
  {
    title: "1. Zona de peluquería/barbería",
    body: "Sillón o silla reclinable hidráulica, más un lavacabezas si vas a ofrecer lavado de cabello.",
    href: "/productos/muebles#sillones-y-sillas-de-peluqueria-barberia",
  },
  {
    title: "2. Zona de estética/masajes",
    body: "Camilla portátil o hidráulica, según el volumen de servicios y si necesitas moverla entre espacios.",
    href: "/productos/muebles#camillas",
  },
  {
    title: "3. Zona de manicura/pedicura",
    body: "Mesa de manicura y silla concha o sillón para pedicura, pensados para la comodidad del cliente durante el servicio.",
    href: "/productos/muebles#mesas-de-trabajo",
  },
  {
    title: "4. Equipo complementario",
    body: "Carritos auxiliares para tener herramientas a mano y tinas o accesorios según el servicio que ofrezcas.",
    href: "/productos/muebles#equipo-y-accesorios-de-salon",
  },
];

const faqs = [
  {
    question: "¿Por dónde empiezo si tengo presupuesto limitado?",
    answer:
      "Prioriza el mueble de la estación que más vas a usar: si tu servicio principal es peluquería, empieza por el sillón; si es estética, por la camilla. El resto se puede ir sumando.",
  },
  {
    question: "¿Puedo comprar los muebles por separado o solo en combos?",
    answer:
      "Cada mueble se vende de forma individual y tiene su propia ficha de precio; puedes armar tu combinación según lo que necesites.",
  },
];
---

<GuideLayout
  title="Cómo equipar un salón de belleza"
  description="Guía paso a paso para equipar un salón de belleza: qué mueble priorizar en cada zona (peluquería, estética, manicura) y en qué orden comprar."
  path="/guias/como-equipar-salon-belleza"
  heading="Cómo equipar un salón de belleza"
  intro="Equipar un salón de belleza desde cero puede ser abrumador. Esta guía ordena las decisiones por zona de servicio, para que sepas qué priorizar según tu presupuesto."
  datePublished="2026-08-08"
  faqs={faqs}
  ctaMessage="Hola, estoy equipando un salón de belleza y quisiera asesoría"
>
  <SectionReveal as="section" class="px-6 pb-16">
    <div class="mx-auto max-w-3xl space-y-8">
      {
        steps.map((step) => (
          <div class="glass-card rounded-2xl p-6">
            <h2 class="font-display text-xl text-primary-900">{step.title}</h2>
            <p class="mt-2 text-ink-muted">{step.body}</p>
            <a href={step.href} class="mt-3 inline-block text-sm font-semibold text-primary-700 hover:underline">
              Ver opciones →
            </a>
          </div>
        ))
      }
    </div>
    <div class="mt-10 text-center">
      <a
        href="/muebles-para-salon-de-belleza-portoviejo"
        class="inline-block rounded-full border-2 border-primary-800 px-6 py-3 font-semibold text-primary-800 hover:bg-primary-800 hover:text-white"
      >
        Ver catálogo completo de muebles →
      </a>
    </div>
  </SectionReveal>
</GuideLayout>
